# In an attrs literal, a non-constant style value is filtered where the bag
# is built (as style={expr}) and again at the leaf: hostile CSS (url(…),
# expression(…), a ';' declaration separator) becomes ZgotmplZ — a
# colon-less fragment the forwarding root's style merge drops — under every
# ASCII spelling of the name. A string constant is authored text, carried as
# gsx.RawCSS; a gsx.RawCSS or css`…` value passes. A style in a bag built in
# Go is filtered at the leaf, so a multi-declaration plain string is dropped.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component Box(attrs gsx.Attrs) {
	<div style="margin:0" { attrs... }>x</div>
}

component Page(user string, ok string, built gsx.Attrs) {
	<Box attrs={{ "style": user }}/>
	<Box attrs={{ "STYLE": "width:expression(" + user + ")" }}/>
	<Box attrs={{ "Style": ok }}/>
	<Box attrs={{ "style": "color:red; top:0" }}/>
	<Box attrs={{ "style": gsx.RawCSS("color:var(--x); top:" + ok) }}/>
	<Box attrs={{ "style": css`color:@{ok}` }}/>
	<Box attrs={ built }/>
}
-- invoke --
Page("background:url(javascript:alert(1))", "blue", gsx.Attrs{{Key: "style", Value: "color:green; top:1px"}})
-- diagnostics.golden --
-- render.golden --
<div style="margin:0">x</div><div style="margin:0">x</div><div style="margin:0">x</div><div style="margin:0; color:red; top:0">x</div><div style="margin:0; color:var(--x); top:blue">x</div><div style="margin:0; color:blue">x</div><div style="margin:0">x</div>
