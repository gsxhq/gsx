# A dynamic value on an event-handler attribute is JavaScript the browser
# runs, so it is encoded as a JS value like html/template does: a string
# becomes a quoted, escaped string literal, a number/bool/struct its JSON, a
# gsx.RawJS verbatim. The name rule is html/template's: after a data- or
# namespace prefix, any name starting with "on" (onclick, ONCLICK, onclick2,
# onlyinteger, data-onclick, svg:onload). Every path agrees: an element
# attribute, a cond/switch branch, a spread bag, a component's fallthrough bag
# and an attrs literal. A bool keeps gsx's presence rule on these names too
# (data-once={false} is absent), decided at runtime for a T string|bool. Authored static text
# stays verbatim everywhere, folds and component fallthrough included; js`…`
# escapes per hole; framework attributes (x-show, @click, x-on:click) are plain.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

type cfg struct {
	ID   int
	Name string
}

component Box(attrs gsx.Attrs) {
	<button { attrs... }>b</button>
}

component Mixed[T string | bool](v T) {
	<i onclick={v} data-once={v}></i>
}

component Page(x string, n int, on bool, c cfg) {
	<div onclick={x}>1</div>
	<div ONCLICK={x} onload={n} ontoggle={on} onwheel={c}>2</div>
	<div onclick={gsx.RawJS("go(1)")}>3</div>
	<div onclick=js`go(@{x})`>4</div>
	<div { if on { onclick={x} } }>5</div>
	<div { switch n { case 1: onclick={x} } }>6</div>
	<div { gsx.Attrs{{"OnClick", x}, {"onmousewheel", n}, {"onclick2", x}}... }>7</div>
	<Box onclick={x}/>
	<Box attrs={{ "onclick": x }}/>
	<div onlyinteger={x} data-onclick={x} x-show={x} @click={x} x-on:click={x}>8</div>
	<div onclick="static()">9</div>
	<div onclick={gsx.Toggle(true)}>10</div>
	<button { gsx.Attrs{{"id", "a"}}... } onclick="fold()" { gsx.Attrs{{"title", "b"}}... }>11</button>
	<Box onclick="comp()"/>
	<Box { if on { onclick="cond()" } }/>
	<svg svg:onload={x}></svg>
	<div data-online={on} data-once={!on} { gsx.Attrs{{"onboarding", on}, {"data-onx", !on}}... }>12</div>
	<Box data-online={on} data-once={!on}/>
	<Mixed v={x}/>
	<Mixed v={true}/>
}
-- invoke --
Page(`alert(1)"</script>`, 1, true, cfg{ID: 1, Name: "<b>"})
