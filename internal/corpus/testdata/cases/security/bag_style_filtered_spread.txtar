# A bag style reaching the leaf through other spread shapes is filtered the
# same way, under every ASCII spelling. Two folded bags merge their style by
# property (the colon-less ZgotmplZ fragment is dropped, so nothing renders);
# a spread nested in a cond-attr writes the style itself, so the failsafe
# renders as style="ZgotmplZ", exactly like style={expr}. RawCSS passes
# verbatim.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component Row(a gsx.Attrs, b gsx.Attrs) {
	<div { a... } { b... }>r</div>
}

component Cond(on bool, a gsx.Attrs) {
	<p { if on { { a... } } }>c</p>
}

component Page() {
	<Row a={{ "style": "background:url(javascript:alert(1))" }} b={{ "id": "x" }}/>
	<Row a={{ "id": "y" }} b={{ "STYLE": "width:expression(alert(1))" }}/>
	<Row a={{ "style": gsx.RawCSS("color:var(--x)") }} b={{ "data-n": "2" }}/>
	<Cond on={true} a={{ "Style": "color:var(--x)" }}/>
	<Cond on={true} a={{ "STYLE": gsx.RawCSS("color:var(--x)") }}/>
}
-- invoke --
Page()
-- diagnostics.golden --
-- render.golden --
<div id="x">r</div><div id="y">r</div><div style="color:var(--x)" data-n="2">r</div><p Style="ZgotmplZ">c</p><p STYLE="color:var(--x)">c</p>
