# A Go-built bag style reaching the leaf through other spread shapes is
# filtered the same way, under every ASCII spelling. Two folded bags merge
# their style by property, keeping the property-less ZgotmplZ fragment in place
# (#229); a spread nested in a cond-attr writes the style itself. Both render
# the failsafe as style="ZgotmplZ", exactly like style={expr}.
# RawCSS passes verbatim.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component Row(a gsx.Attrs, b gsx.Attrs) {
	<div { a... } { b... }>r</div>
}

component Cond(on bool, a gsx.Attrs) {
	<p { if on { { a... } } }>c</p>
}

component Page(hostile gsx.Attrs, upper gsx.Attrs, vouched gsx.Attrs) {
	<Row a={ hostile } b={{ "id": "x" }}/>
	<Row a={{ "id": "y" }} b={ upper }/>
	<Row a={ vouched } b={{ "data-n": "2" }}/>
	<Cond on={true} a={ upper }/>
	<Cond on={true} a={ vouched }/>
}
-- invoke --
Page(
	gsx.Attrs{{Key: "style", Value: "background:url(javascript:alert(1))"}},
	gsx.Attrs{{Key: "STYLE", Value: "width:expression(alert(1))"}},
	gsx.Attrs{{Key: "Style", Value: gsx.RawCSS("color:var(--x)")}},
)
-- diagnostics.golden --
-- render.golden --
<div style="ZgotmplZ" id="x">r</div><div style="ZgotmplZ" id="y">r</div><div style="color:var(--x)" data-n="2">r</div><p STYLE="ZgotmplZ">c</p><p Style="color:var(--x)">c</p>
