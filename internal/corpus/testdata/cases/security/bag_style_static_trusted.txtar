# An authored static style on a component tag is author text: codegen carries
# it into the bag as gsx.RawCSS, so a multi-declaration value with url(),
# var() and quotes renders as written through the leaf's CSS value filter,
# under every ASCII spelling, as does a css`…` literal (holes filtered) and a
# constant in an attrs literal.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component Box(attrs gsx.Attrs) {
	<div class="box" { attrs... }>x</div>
}

component Page(c string) {
	<Box style="color:red; background:url(/a.png); font-family:'X'; margin:var(--m)"/>
	<Box STYLE="top:0; left:calc(100% - 1px)"/>
	<Box Style=css`color:@{c}; margin:0`/>
	<Box attrs={{ "style": "color:red; top:0" }}/>
}
-- invoke --
Page("blue")
-- diagnostics.golden --
-- render.golden --
<div class="box" style="color:red; background:url(/a.png); font-family:&#39;X&#39;; margin:var(--m)">x</div><div class="box" style="top:0; left:calc(100% - 1px)">x</div><div class="box" style="color:blue;margin:0">x</div><div class="box" style="color:red; top:0">x</div>
