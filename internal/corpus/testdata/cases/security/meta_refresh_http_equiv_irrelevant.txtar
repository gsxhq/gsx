# The refresh sink does NOT consult http-equiv. `content` on <meta> is a URL
# sink by (tag, name) alone — html/template's rule (transition.go: `c.element ==
# elementMeta && attrName == "content"`) — so no shape of the sibling attribute
# can evade it.
#
# This replaces three cases that pinned whether codegen could SEE an
# http-equiv="refresh" (static / expr-literal / inside a cond-attr), plus a
# fourth that pinned the resulting bypass for a dynamic one. That whole question
# is gone: the four shapes below now sanitize identically, and two of them —
# Dynamic and InBag — did not before (issue #171).
#
# Reading http-equiv bought nothing even when it worked: refreshContentSanitize
# returns any value that isn't a refresh directive unchanged, which is what
# NotARefresh pins.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component StaticEquiv(to string) {
	<meta http-equiv="refresh" content={"0;url=" + to}/>
}

component ExprEquiv(to string) {
	<meta http-equiv={"refresh"} content={"0;url=" + to}/>
}

component CondEquiv(legacy bool, to string) {
	<meta { if legacy { http-equiv="refresh" } } content={"0;url=" + to}/>
}

component DynamicEquiv(kind string, to string) {
	<meta http-equiv={kind} content={"0;url=" + to}/>
}

component EquivInBag(attrs gsx.Attrs, to string) {
	<meta content={"0;url=" + to} { attrs... }/>
}

component NoEquivAtAll(to string) {
	<meta content={"0;url=" + to}/>
}

component NotARefresh(v string) {
	<meta name="description" content={v}/>
}

component Page() {
	<StaticEquiv to={"javascript:alert(1)"}/>
	<ExprEquiv to={"javascript:alert(2)"}/>
	<CondEquiv legacy={true} to={"javascript:alert(3)"}/>
	<DynamicEquiv kind={"refresh"} to={"javascript:alert(4)"}/>
	<EquivInBag attrs={gsx.Attrs{{Key: "http-equiv", Value: "refresh"}}} to={"javascript:alert(5)"}/>
	<NoEquivAtAll to={"javascript:alert(6)"}/>
	<NotARefresh v={"A perfectly ordinary description."}/>
	<NotARefresh v={"5;url=/relative-is-allowed"}/>
}
-- invoke --
Page()
-- diagnostics.golden --
-- render.golden --
<meta http-equiv="refresh" content="0;url=about:invalid#gsx"><meta http-equiv="refresh" content="0;url=about:invalid#gsx"><meta http-equiv="refresh" content="0;url=about:invalid#gsx"><meta http-equiv="refresh" content="0;url=about:invalid#gsx"><meta content="0;url=about:invalid#gsx" http-equiv="refresh"><meta content="0;url=about:invalid#gsx"><meta name="description" content="A perfectly ordinary description."><meta name="description" content="5;url=/relative-is-allowed">
