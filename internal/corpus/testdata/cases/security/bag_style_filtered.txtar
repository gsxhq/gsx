# A style value from a bag is sanitized like style={expr}: any value the CSS
# value filter rejects (url(…), expression(…), a -- run, var(--x), a ';'
# declaration separator) becomes ZgotmplZ, under every ASCII spelling of the
# name. On a forwarding element the bag style merges by property, and the
# colon-less failsafe fragment is dropped there (as a failsafe root style
# is), so the hostile value never renders. A RawCSS value is the author's
# vouch and passes verbatim; a plain declaration passes the filter.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component Box(attrs gsx.Attrs) {
	<div style="margin:0" { attrs... }>x</div>
}

component Page() {
	<Box attrs={{ "style": "background:url(javascript:alert(1))" }}/>
	<Box attrs={{ "STYLE": "width:expression(alert(1))" }}/>
	<Box attrs={{ "Style": "color:red--x" }}/>
	<Box attrs={{ "style": "color:var(--x)" }}/>
	<Box attrs={{ "style": "color:red; top:0" }}/>
	<Box attrs={{ "STYLE": gsx.RawCSS("color:var(--x); top:0") }}/>
	<Box attrs={{ "Style": "color:blue" }}/>
}
-- invoke --
Page()
