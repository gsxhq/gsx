# In an attrs literal, a style value is trusted only when it is the author's
# string constant as written. A constant whose type has a registered renderer
# is whatever the renderer returns — it may read ctx, or return a number — so
# that output takes the dynamic path: a ctx-reading renderer's hostile CSS is
# filtered (ZgotmplZ), and float64/int results are stringified like any
# attribute value before the filter. A plain constant stays trusted. The Cond
# spread writes the style itself, so each value is visible.
-- gsx.toml --
[renderers]
"./pg.Color" = "./rend.Color"
"./pg.Width" = "./rend.Width"
"./pg.Num" = "./rend.Num"
-- pg/pg.go --
package pg

type Color string
type Width string
type Num string

const (
	Red   Color = "red"
	Wide  Width = "wide"
	Count Num   = "count"
)
-- rend/rend.go --
package rend

import (
	"context"

	"corpustest/cases/security_attrs_literal_style_renderer/pg"
)

type key struct{}

func Color(ctx context.Context, c pg.Color) string {
	if v, ok := ctx.Value(key{}).(string); ok {
		return v
	}
	return "background:url(javascript:alert(1))"
}

func Width(w pg.Width) float64 { return 1.5 }

func Num(n pg.Num) int { return 42 }
-- input.gsx --
package views

import (
	"github.com/gsxhq/gsx"

	"corpustest/cases/security_attrs_literal_style_renderer/pg"
)

component Cond(attrs gsx.Attrs) {
	<p { if true { { attrs... } } }>c</p>
}

component Page() {
	<Cond attrs={{ "style": pg.Red }}/>
	<Cond attrs={{ "STYLE": pg.Wide }}/>
	<Cond attrs={{ "Style": pg.Count }}/>
	<Cond attrs={{ "style": "color:red; top:0" }}/>
}
-- invoke --
Page()
-- diagnostics.golden --
-- render.golden --
<p style="ZgotmplZ">c</p><p STYLE="1.5">c</p><p Style="42">c</p><p style="color:red; top:0">c</p>
