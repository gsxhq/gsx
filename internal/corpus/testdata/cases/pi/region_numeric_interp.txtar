# A numeric interpolation inside a region. A region opens no Go scope — genNode
# emits its children inline into the enclosing render closure — so a numeric hole
# there uses THIS scope's `_gsxnum` scratch array. emit's scopeUsesNumeric walk
# lacked an *ast.MarkerRegion case, so `_gsxnum` was never declared: generation
# exited 0, emitted `_gsxgw.IntInto(_gsxnum[:], int64(n))`, and `go build` then
# failed with `undefined: _gsxnum`. The corpus compiles every renderable case, so
# the `var _gsxnum [32]byte` line in generated.x.go.golden IS the pin — a
# regression here fails the build, not just the golden compare. A uint is
# included because it routes through the same scratch array via UintInto.
-- input.gsx --
package views

component RegionNum(n int, u uint) {
	<?start name="r">{ n }/{ u }<?end>
}
-- invoke --
RegionNum(-42, 7)
-- diagnostics.golden --
-- render.golden --
<?start name="r">-42/7<?end>
-- generated.x.go.golden --
// Code generated by gsx; DO NOT EDIT.

package views

import (
	_gsxctx "context"
	_gsxrt "github.com/gsxhq/gsx"
	_gsxio "io"
)

//line input.gsx:3:1
func RegionNum(n int, u uint) _gsxrt.Node {
	return _gsxrt.Func(func(ctx _gsxctx.Context, _gsxw _gsxio.Writer) error {
		_gsxgw := _gsxrt.W(_gsxw)
		var _gsxnum [32]byte
		_gsxgw.S("<?start name=\"r\">")
//line input.gsx:4:19
		_gsxgw.IntInto(_gsxnum[:], int64(n))
		_gsxgw.S("/")
//line input.gsx:4:25
		_gsxgw.UintInto(_gsxnum[:], uint64(u))
		_gsxgw.S("<?end>")
		return _gsxgw.Err()
	})
}
