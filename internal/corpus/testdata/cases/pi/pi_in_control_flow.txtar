# Markers are ordinary markup nodes: genNode's *ast.Marker/*ast.MarkerRegion
# cases are reached from inside a control-flow body exactly like an element,
# so a marker inside `{ if … }` and one inside `{ for … }` both emit. Pins
# that PIs get no special-cased control-flow handling — they ride the same
# body-walk as everything else.
-- input.gsx --
package views

component Page(show bool, ids []string) {
	{ if show {
		<?marker name="banner">
	} }
	{ for _, id := range ids {
		<?marker name={id}>
	} }
}
-- invoke --
Page(true, []string{"a", "b"})
-- render.golden --
<?marker name="banner"><?marker name="a"><?marker name="b">
