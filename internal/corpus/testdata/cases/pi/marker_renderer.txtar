# A registered [renderers] type used as a dynamic PI name. emitPIName never
# called applyRenderer, so `<?marker name={v}>` emitted a bare
# `_gsxgw.PIName(v)` and `go build` failed with `cannot use v (variable of
# struct type pg.ID) as string value` — while the very same `{v}` in text
# position correctly rendered through the registered renderer. The renderer now
# applies in BOTH positions: renderer FIRST, PI-name sink AFTER, so the
# renderer's OUTPUT is what the sink validates. The invoked value is `a>b` and
# the renderer rewrites '>' to '-': the PIName sink REJECTS '>' at render time,
# so the render succeeding at all is the proof that the renderer ran before the
# sink rather than after it.
-- gsx.toml --
[renderers]
"./pg.ID" = "./rend.PgID"
-- pg/pg.go --
package pg

type ID struct {
	Raw string
}
-- rend/rend.go --
package rend

import (
	"strings"

	"corpustest/cases/pi_marker_renderer/pg"
)

func PgID(i pg.ID) string { return strings.ReplaceAll(i.Raw, ">", "-") }
-- input.gsx --
package views

import "corpustest/cases/pi_marker_renderer/pg"

func mkID(s string) pg.ID { return pg.ID{Raw: s} }

component Marked(v pg.ID) {
	<?marker name={v}>
	<p>{v}</p>
}
-- invoke --
Marked(mkID("a>b"))
-- diagnostics.golden --
-- render.golden --
<?marker name="a-b"><p>a-b</p>
-- generated.x.go.golden --
// Code generated by gsx; DO NOT EDIT.

package views

import (
	"corpustest/cases/pi_marker_renderer/pg"

	_gsxctx "context"
	_gsxf0 "corpustest/cases/pi_marker_renderer/rend"
	_gsxrt "github.com/gsxhq/gsx"
	_gsxio "io"
)

//line input.gsx:5:1
func mkID(s string) pg.ID { return pg.ID{Raw: s} }

//line input.gsx:7:1
func Marked(v pg.ID) _gsxrt.Node {
	return _gsxrt.Func(func(ctx _gsxctx.Context, _gsxw _gsxio.Writer) error {
		_gsxgw := _gsxrt.W(_gsxw)
		_gsxgw.S("<?marker name=\"")
		_gsxgw.PIName(string(_gsxf0.PgID((v))))
		_gsxgw.S("\">")
//line input.gsx:9:2
		_gsxgw.S("<p>")
//line input.gsx:9:5
		_gsxgw.Text(string(_gsxf0.PgID((v))))
		_gsxgw.S("</p>")
		return _gsxgw.Err()
	})
}
