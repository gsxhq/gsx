# The three string-like categories a dynamic PI name accepts. emitPIName used
# urlStringExpr, which converts only catString and passes everything else through
# raw — so a []byte or a fmt.Stringer name compiled to `_gsxgw.PIName(b)` /
# `_gsxgw.PIName(s)` and failed `go build` with a type error naming the internal
# sink. It now uses the same stringLikeExpr conversion the meta-refresh sink
# uses: `string(b)` for []byte, `(s).String()` for a Stringer. The corpus
# compiles every renderable case, so these two lines building at all is the pin.
-- model.go --
package views

type name string

func (n name) String() string { return "S:" + string(n) }
-- input.gsx --
package views

component Marked(s string, b []byte, n name) {
	<?marker name={s}>
	<?marker name={b}>
	<?marker name={n}>
}
-- invoke --
Marked("plain", []byte("bytes"), name("st"))
-- diagnostics.golden --
-- render.golden --
<?marker name="plain"><?marker name="bytes"><?marker name="S:st">
-- generated.x.go.golden --
// Code generated by gsx; DO NOT EDIT.

package views

import (
	_gsxctx "context"
	_gsxrt "github.com/gsxhq/gsx"
	_gsxio "io"
)

//line input.gsx:3:1
func Marked(s string, b []byte, n name) _gsxrt.Node {
	return _gsxrt.Func(func(ctx _gsxctx.Context, _gsxw _gsxio.Writer) error {
		_gsxgw := _gsxrt.W(_gsxw)
		_gsxgw.S("<?marker name=\"")
		_gsxgw.PIName(string(s))
		_gsxgw.S("\"><?marker name=\"")
		_gsxgw.PIName(string(b))
		_gsxgw.S("\"><?marker name=\"")
		_gsxgw.PIName((n).String())
		_gsxgw.S("\">")
		return _gsxgw.Err()
	})
}
