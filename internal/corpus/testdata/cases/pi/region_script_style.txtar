# A <script> and a <style> inside a region. The corpus generates with
# CSSMinify/JSMinify ON, so this pins internal/jsmin's and internal/cssmin's
# minifyMarkup walks: both lacked an *ast.MarkerRegion case, so a region's
# <script>/<style> body was silently left UNMINIFIED (and, with minify off,
# codegen's rebaseMarkup likewise left the markup-depth indentation in the
# shipped asset — see TestRebaseMarkerRegionChildren for that half). The sibling
# <div> carries the same two bodies at the same source depth, so the two render
# byte-identically: a region must be transparent to asset processing.
-- input.gsx --
package views

component Assets() {
	<?start name="r">
		<script>
			function init() {
				return 1;
			}
		</script>
		<style>
			.a {
				color: red;
			}
		</style>
	<?end>
	<div>
		<script>
			function init() {
				return 1;
			}
		</script>
		<style>
			.a {
				color: red;
			}
		</style>
	</div>
}
-- invoke --
Assets()
-- diagnostics.golden --
-- render.golden --
<?start name="r"><script>function init() {
return 1;
}</script><style>.a{color: red}</style><?end><div><script>function init() {
return 1;
}</script><style>.a{color: red}</style></div>
