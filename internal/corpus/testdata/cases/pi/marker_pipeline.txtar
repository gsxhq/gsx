# A dynamic <?marker name={…}> value can carry a `|>` pipeline stage, exactly
# like any other ExprAttr value: emitPIName lowers it through the same
# lowerPipe call an href={} value's probe uses, then the PIName sink still
# rejects '>'/'"' at render time. `upper` is a corpus-registered filter (see
# pipelines/bare.txtar) — reused rather than inventing a new one.
-- input.gsx --
package views

component Page(id string) {
	<?marker name={id |> upper}>
}
-- invoke --
Page("row-1")
-- render.golden --
<?marker name="ROW-1">
