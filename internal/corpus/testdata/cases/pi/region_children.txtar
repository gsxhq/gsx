# A MarkerRegion's children mix an element, text, and an interpolation. The
# element sits on its OWN indented source line (block-level child) — this is
# the load-bearing shape: Task 7 found normalizeMarkup had no *ast.MarkerRegion
# case, so a region's children never got JSX whitespace collapsing, and the
# region's source indentation (newlines/tabs before/after the block-level
# <span>) rendered LITERALLY into the HTML. wsnorm now walks MarkerRegion
# children like a Fragment's, so the cosmetic indentation here must vanish from
# render.golden exactly as it does around any other block-level child.
-- input.gsx --
package views

component Page(id string) {
	<?start name="feed">
		<span>x</span>
		loading { id }
	<?end>
}
-- invoke --
Page("row-1")
-- render.golden --
<?start name="feed"><span>x</span>loading row-1<?end>
-- generated.x.go.golden --
