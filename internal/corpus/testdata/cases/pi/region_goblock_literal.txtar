# A `js`…`` and a `css`…`` literal inside a `{{ }}` block inside a region.
# codegen's analyze materializeEmbeddedMarkup walk lacked an *ast.MarkerRegion
# case, so splitGoBlock never ran on a region's blocks: the backtick literal
# stayed inside the raw Go text and go/parser rejected it with a bogus
# `error[parse-error]: expected ';', found `f(@{v})``. The identical source in a
# <div> exited 0. Both languages are pinned because each has its own
# GoBlock.Embedded consumer (jsmin/cssmin minifyGoParts, codegen rebaseGoParts)
# reached only through this walk.
-- input.gsx --
package views

component RegionGoBlock(v string) {
	<?start name="r">
		{{
			h := js`f(@{v})`
			s := css`color: @{v};`
		}}
		<div @click={h} style={s}>x</div>
	<?end>
}
-- invoke --
RegionGoBlock("red")
-- diagnostics.golden --
