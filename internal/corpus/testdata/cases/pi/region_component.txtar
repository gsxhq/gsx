# A component call inside a `<?start>…<?end>` region — the spec's own headline
# example (`<?start name="feed"><Spinner/><?end>`). This is the load-bearing
# shape: BOTH component-resolution walks in component_target.go
# (collectMaterializedComponentCandidates and callSiteRegistry.collectFile)
# lacked an *ast.MarkerRegion case, so Element.IsComponent was never stamped for
# a region's children and `<Spinner/>` was emitted as RAW HTML
# (`_gsxgw.S("<Spinner></Spinner>")`) with no diagnostic at all. A region opens
# no scope, so the call must lower to the same inline `_gsxrenderSpinner(ctx,
# _gsxgw)` a `<div>` produces. Lowercase `<spinner/>` resolves through the same
# stamp, so both spellings are pinned here; the sibling <div> proves parity.
-- input.gsx --
package views

component Spinner() { <em>spin</em> }

component spinner() { <i>lower</i> }

component RegionCalls() {
	<?start name="feed">
		<Spinner/>
		<spinner/>
	<?end>
	<div>
		<Spinner/>
	</div>
}
-- invoke --
RegionCalls()
-- diagnostics.golden --
-- render.golden --
<?start name="feed"><em>spin</em><i>lower</i><?end><div><em>spin</em></div>
