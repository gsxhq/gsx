# A MarkerRegion nests: an outer <?start>/<?end> region contains an inner
# region, which contains a void marker. Each `<?end>` closes its nearest
# unclosed `<?start>` (parseChildrenTerm's piEnd terminator is scoped to the
# call that opened it), so the two `<?end>`s pair innermost-first.
-- input.gsx --
package views

component Page() {
	<?start name="outer">
		<?start name="inner">
			<?marker name="leaf">
		<?end>
	<?end>
}
-- invoke --
Page()
-- render.golden --
<?start name="outer"><?start name="inner"><?marker name="leaf"><?end><?end>
