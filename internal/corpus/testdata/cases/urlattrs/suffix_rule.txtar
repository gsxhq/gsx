# A project [url_attrs] SUFFIX rule. The `*-url` naming convention is real and a
# prefix rule cannot express it: data-cancel-url and data-submit-url share no
# leading string worth matching. Like a prefix rule it cannot be enumerated into
# Get blocks, so it travels to the leaf as gsx.AttrSinks{Suffixes: …} and Spread
# routes every suffix-matched key through the STRICT navigational sink — a
# project rule never earns the image-sink allowance.
#
# data-cancel-url is sanitized on the element AND through a bag; data-urlish is
# NOT matched (the suffix is "-url", not "url"), pinning that the match is
# end-anchored on the whole name rather than a substring.
-- gsx.toml --
[url_attrs]
suffixes = ["-url"]
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component Direct(u string) {
	<a data-cancel-url={u} data-urlish={u}>x</a>
}

component Bagged(attrs gsx.Attrs) {
	<a { attrs... }>y</a>
}

component Page() {
	<Direct u={"javascript:alert(1)"}/>
	<Direct u={"/safe"}/>
	<Bagged attrs={gsx.Attrs{
		{Key: "data-submit-url", Value: "javascript:alert(2)"},
		{Key: "data-urlish", Value: "javascript:alert(3)"},
	}}/>
}
-- invoke --
Page()
-- diagnostics.golden --
-- render.golden --
<a data-cancel-url="about:invalid#gsx" data-urlish="javascript:alert(1)">x</a><a data-cancel-url="/safe" data-urlish="/safe">x</a><a data-submit-url="about:invalid#gsx" data-urlish="javascript:alert(3)">y</a>
