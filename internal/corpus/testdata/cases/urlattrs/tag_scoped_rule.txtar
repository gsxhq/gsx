# A project [url_attrs.tags.<element>] rule: a name that carries a URL on ONE
# element and nothing anywhere else — the shape the built-in floor uses for
# `content` on <meta>, now expressible by a project.
#
# data-src is a URL on <img> and an ordinary attribute on <div>. Codegen resolves
# the tag scope at GENERATE time (it knows the element), so the emitted
# gsx.AttrSinks carries the name only on the <img> spread and nothing
# tag-dependent reaches the runtime.
-- gsx.toml --
[url_attrs.tags.img]
names = ["data-src"]
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component Img(u string) {
	<img data-src={u}/>
}

component Div(u string) {
	<div data-src={u}></div>
}

component BaggedImg(attrs gsx.Attrs) {
	<img { attrs... }/>
}

component BaggedDiv(attrs gsx.Attrs) {
	<div { attrs... }></div>
}

component Page() {
	<Img u={"javascript:alert(1)"}/>
	<Div u={"javascript:alert(2)"}/>
	<BaggedImg attrs={gsx.Attrs{{Key: "data-src", Value: "javascript:alert(3)"}}}/>
	<BaggedDiv attrs={gsx.Attrs{{Key: "data-src", Value: "javascript:alert(4)"}}}/>
}
-- invoke --
Page()
-- diagnostics.golden --
-- render.golden --
<img data-src="about:invalid#gsx"><div data-src="javascript:alert(2)"></div><img data-src="about:invalid#gsx"><div data-src="javascript:alert(4)"></div>
