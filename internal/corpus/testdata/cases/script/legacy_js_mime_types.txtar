# A <script> runs as JavaScript when its type is one of the WHATWG JavaScript
# MIME type essences (legacy spellings included) or "module", matched
# case-insensitively with any ;parameters ignored — the html/template isJSType
# rule. Such a body is JS with per-position holes, not a one-value data island.
# Any other type (application/json, importmap) stays a data island.
-- input.gsx --
package views

component Page(id string) {
	<script type="application/x-javascript">load(@{id})</script>
	<script type="text/jscript">load("@{id}")</script>
	<script type="text/javascript1.5">load(@{id})</script>
	<script type=" Text/X-JavaScript ">load(@{id})</script>
	<script type="text/javascript; charset=utf-8">load(@{id})</script>
	<script type="importmap">@{map[string]string{"x": id}}</script>
}
-- invoke --
Page("a</script>")
