# serialization = "verbatim" restores authored-shape emission: a self-closed
# non-void element ships as authored. Exact render bytes pin that spelling.
# The #144 browser quirk still matters: browsers ignore the slash in <span/>,
# so a following <b> nests inside the span rather than becoming its sibling.
# This is deliberately different from canonical <span></span><b> emission.
-- gsx.toml --
serialization = "verbatim"
-- input.gsx --
package views

component Sep() {
	<div><span role="separator"/><b>after</b></div>
}
-- invoke --
Sep()
-- diagnostics.golden --
-- render.golden --
<div><span role="separator"/><b>after</b></div>
