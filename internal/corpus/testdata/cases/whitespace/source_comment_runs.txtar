package views

import "github.com/gsxhq/gsx"

component Root() { {/* first */} root {/* last */} }
component Slot(content gsx.Node) { <aside>{content}</aside> }
component Page(value int) {
	<main>
		<p>Hello{/* first */}
			{/* second */}world</p>
		<p>Hello{/* comment */}
			<b>world</b></p>
		<p>Hello {/* comment */} world</p>
		<p>Hello
			{/* first */}
			{/* second */}
			world</p>
		<p>
			{/* first */}Hello{/* second */}
		</p>
		<p><b>A</b>{/* first */}
			{/* second */}<i>B</i></p>
		<p>{value}{/* first */}
			{/* second */}{value}</p>
		<p>Hello<!-- first -->
			<!-- second -->world</p>
		<p>Hello{{ _ = value }}
			world</p>
		<p>Hello {/* first */} {/* second */} world</p>
		<p>
			{/* only */}
		</p>
		<p>  {/* first */}  {/* second */}   </p>
		<p><!-- first --> Hello</p>
		<p>Hello <!-- last --></p>
		<p><!-- first --> <!-- second --></p>
		<Root/>
		<Slot content={ <b/>{/* first */} slot {/* last */} }/>
		{ if true { {/* first */} branch {/* last */} } }
	</main>
}
