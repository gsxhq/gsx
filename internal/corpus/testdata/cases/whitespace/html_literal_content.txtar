package views

import "github.com/gsxhq/gsx"

func identity(node gsx.Node) gsx.Node { return node }

var embedded = <div>embedded
 	<span>x</span> tail</div>

component Scalar(children gsx.Node) { <section>{children}</section> }
component Variadic(children ...gsx.Node) { <article>{ for _, child := range children { {child} } }</article> }
component Slot(content gsx.Node) { <aside>{content}</aside> }
component Roots() {
  <i>a</i>
 	<b>b</b>
}
component Page() {
  <main><p>Hello
 	<strong>world</strong>!</p><span>{ 2 }%</span><i>x</i><b>y</b>
<div class="whitespace-pre-wrap"> first
 	second </div><> fragment
 <em>text</em> </><?start name="literal"> marker
 <em>text</em> <?end>
<Scalar/><Variadic/><Scalar> 	</Scalar><Variadic> 	</Variadic>
<Scalar>
  <i>a</i> 	<b>b</b>
</Scalar><Variadic>
  <i>a</i> 	<b>b</b>
</Variadic><Slot content={
  <i>a</i>
 	<b>b</b>
}/><Roots/>{ embedded }
<div>{ identity(<span>deferred
 	<strong>literal</strong> tail</span>) }</div>
<p>before {/* source comment */} after<!-- emitted --> end</p>
<div>{ if true { <i>yes</i>
 	<b>also</b> } else { no } }!{ if false { absent } }?</div>
<div>{ for _, word := range []string{"a", "b"} { {word}
 	<i>end</i> } }</div>
<div>{ for false { absent } }</div>
<div>{ switch 1 { case 1: <i>one</i>
 	<b>two</b> default: absent } }</div>
<div>
  <i>a</i>
  // source comment between elements
  <b>b</b>
</div></main>
}
