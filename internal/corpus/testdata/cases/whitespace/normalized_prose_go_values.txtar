Markup in every Go-expression position (package var, call argument, attribute,
{{ }} block, slot) normalizes like body markup; an enclosing pre does not
leak into a nested Go value.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

func identity(node gsx.Node) gsx.Node { return node }
var top = <p>Top
	<b>value</b></p>
component Shell(content gsx.Node) { <section>{content}</section> }
component Page() {
	<main>{top}{identity(<p>Body
		<b>value</b></p>)}<Shell content={identity(<p>Attribute
		<b>value</b></p>)}/>
	{{ value := <p>Block
		<b>value</b></p> }}{value}
	<Shell content={ <p>Slot
		<b>value</b></p> }/>
	<pre>{identity(<b>Nested
		<em>value</em></b>)}</pre></main>
}
-- invoke --
Page()
