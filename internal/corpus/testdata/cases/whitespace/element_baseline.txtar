Element-body whitespace baseline: single spaces, repeated spaces and interior
newlines are emitted literally. Control-flow interiors share this contract;
only their outer syntactic body edges trim.
-- input.gsx --
package views

component Base(a, b string) {
	<div id="s1">{a} - end</div>
	<div id="s3">{a} {b}</div>
	<div id="s4">{a}   -   {b}</div>
}
-- invoke --
Base("x", "y")
-- diagnostics.golden --
-- render.golden --
<div id="s1">x - end</div>
	<div id="s3">x y</div>
	<div id="s4">x   -   y</div>
