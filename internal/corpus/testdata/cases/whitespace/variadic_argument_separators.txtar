package views

import "github.com/gsxhq/gsx"

type NodeAlias = gsx.Node
component List(children ...NodeAlias) { <ul>{ for _, child := range children { <li>{child}</li> } }</ul> }
component Scalar(children gsx.Node) { <section>{children}</section> }
component Slot(content gsx.Node) { <aside>{content}</aside> }
component Page() {
<main><List>
  <i>a</i>
  <b>b</b>
</List><List>
  <i>a</i>
  {" "}
  <b>b</b>
</List><List/><List> 	
</List><List>
  {/* only a source comment */}
</List><List> before <i>a</i> after </List><List> <i>a</i></List><List>
