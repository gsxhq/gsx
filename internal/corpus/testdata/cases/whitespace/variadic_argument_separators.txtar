  { if true { <i>b</i>
 <b>c</b> } }
  { for _, v := range []string{"x", "y"} { <i>{v}</i> } }
  { switch 1 { case 1: <i>d</i> default: absent } }
</List><Scalar> 	</Scalar><Scalar>
