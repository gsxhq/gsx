package views

import "github.com/gsxhq/gsx"

func identity(node gsx.Node) gsx.Node { return node }

var top = <p>Top
	<b>level</b></p>

component Slot(content gsx.Node) { <aside>{content}</aside> }
component Children(children gsx.Node) { <section>{children}</section> }
component Items(children ...gsx.Node) {
	<ul>{ for _, child := range children { <li>{child}</li> } }</ul>
}
component Page(value int, name string, ok bool) {
	<main><p>Hello
		<b>world</b>
	</p><span>A</span>
	<span>B</span><p>{value}
		%
	</p><p>{name}
		world</p><p>Hello
		{name}</p><p>{value} %</p><p>{value}{"  "}
		%</p><p>{name}
		…</p><p>Hello
		{/* source comment */}
		world</p><p>Hello
		{ if ok { . } else { ! } }</p><p>Hello
		{ if ok { word } }!</p><p>Groups:
		{ for i, label := range []string{"A", "B"} {
			{ if i > 0 { {" and "} } else { {" "} } }<span>{label}</span>
		} }
	</p><Slot content={ <p>Slot
		<b>value</b></p> }/><Children>Hello
		<b>child</b></Children><Items>
		<b>A</b>
		<b>B</b>
	</Items><Items><b>A</b>{" "}<b>B</b></Items>{top}{identity(<p>Deferred
		<b>value</b></p>)}<pre>Keep
		<b>space</b></pre></main>
}
-- invoke --
Page(42, "Ada", false)
