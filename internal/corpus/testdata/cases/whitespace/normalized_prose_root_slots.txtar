Root and slot prose retains source boundaries before substantive text, while
layout-only tag separators and syntactic body-leading indentation remain absent.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component Root() {
	<b>x</b>
	word
}
component RootPunctuation() {
	<b>x</b>
	%
}
component RootFirst() {
	first
}
component Slot(content gsx.Node) { <aside>{content}</aside> }
component Page() {
	<main><Root/><RootPunctuation/>
	<Slot content={ <b>x</b>
		word
	}/>
	<Slot content={ <b>x</b>
		%}/>
	<Slot content={ <b>x</b> %}/>
	<RootFirst/>
	<Slot content={ <b>x</b>
		<i>y</i> }/>
	</main>
}
-- invoke --
Page()
