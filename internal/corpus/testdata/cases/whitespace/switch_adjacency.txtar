An opening control-flow brace directly after source text preserves adjacency.
Inline and newline separators remain spaces, even when no switch case matches.
-- input.gsx --
package views

component Example(n int) {
	<section id="joined">
		Total{ switch n {
			case 0:
				<div>none</div>
		} }
		<b>{ n }</b>
	</section>
	<section id="inline">
		Total { switch n {
			case 0:
				<div>none</div>
		} }
		<b>{ n }</b>
	</section>
	<section id="newline">
		Total
		{ switch n {
			case 0:
				<div>none</div>
		} }
		<b>{ n }</b>
	</section>
}
component Page() {
	<Example n={0}/>
	<Example n={3}/>
}
-- invoke --
Page()
