Authored prose separators depend on source siblings, never their tag, branch
outcomes or runtime content. Newline and inline separators have the same
meaning; whitespace-only inter-tag indentation remains layout.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component Link(children gsx.Node) { <a>{children}</a> }
component Empty() {}
component Slot(content gsx.Node) { <aside>{content}</aside> }
component Root() {
	<Link>root</Link>
	text
}
component RootInline() { <b>A</b> <b>B</b> }
component Rules(ok bool, value int) {
	<main>
		<p>Hello
			<Link>world</Link></p>
		<p>Read
			<img alt=""/>
			more</p>
		<section>Before
			<div>block</div>
			after</section>
		<p>Hello
			<Empty/>
			world</p>
		<p>{value}
			%</p>
		<p>a&nbsp;
			b</p>
		<p>a&nbsp;
			{"b"}</p>
		<p>{value}{"  "}
			%</p>
		<p>Hello
			{ if ok { <b>branch</b> } }
			world</p>
		<p>«
			Bonjour
			»</p>
		<p>Read
			<svg><title>icon</title></svg>
			more</p>
		<p>Hello
			{/* source comment */}
			world</p>
		<span>A</span>
		<span>B</span>
		<Root/>
		<RootInline/>
		<Slot content={ <b>A</b> <b>B</b> }/>
		<Slot content={ <Link>slot</Link>
			text }/>
		<p>Hello<Link>joined</Link>!</p>
	</main>
}
component Page() {
	<Rules ok={false} value={42}/>
	<Rules ok={true} value={42}/>
}
-- invoke --
Page()
