-- support.go --
package views

import (
	"context"
	"io"

	"github.com/gsxhq/gsx"
)

func withTestNonce(n gsx.Node) gsx.Node {
	return gsx.Func(func(ctx context.Context, w io.Writer) error {
		return n.Render(gsx.WithNonce(ctx, "r4nd0m"), w)
	})
}
-- input.gsx --
package views

component Page(rel, href string) { <link rel={rel} href={href}/> }
-- invoke --
withTestNonce(Page("preload", "/font.woff2"))
-- diagnostics.golden --
-- render.golden --
<link rel="preload" href="/font.woff2" nonce="r4nd0m">
