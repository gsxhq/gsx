# A nonce from a `{ switch … }` arm — an explicit nonce attribute or a spread
# carrying one — suppresses the automatic context nonce exactly as one from
# an `{ if … }` branch does; an untaken arm leaves the context nonce.
-- support.go --
package views

import (
	"context"
	"io"

	"github.com/gsxhq/gsx"
)

func withTestNonce(n gsx.Node) gsx.Node {
	return gsx.Func(func(ctx context.Context, w io.Writer) error {
		return n.Render(gsx.WithNonce(ctx, "r4nd0m"), w)
	})
}
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component Page(n int, extra gsx.Attrs) {
	<script { switch n { case 1: { extra... } } }>a()</script>
	<script { switch n { case 1: nonce="manual" } }>b()</script>
	<script { switch n { case 2: nonce="manual" } }>c()</script>
}
-- invoke --
withTestNonce(Page(1, gsx.Attrs{{Key: "nonce", Value: "bag"}}))
-- diagnostics.golden --
-- render.golden --
<script nonce="bag">a()</script><script nonce="manual">b()</script><script nonce="r4nd0m">c()</script>
