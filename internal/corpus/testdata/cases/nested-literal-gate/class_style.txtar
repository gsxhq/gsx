# class/style parts, their `: cond` guards, and value-form if/switch headers
# and arms: a nested literal is a positioned nested-literal diagnostic. (A
# literal that IS the whole part — `f` in class, `css` in style — is ordinary
# composition and not gated.)
-- input.gsx --
package demo

func wrap(s string) string { return s }
func ok(s string) bool     { return s != "" }

component Page(id int) {
	<i class={ "x", wrap(f`c-@{id}`), "on": ok(f`d-@{id}`) }></i>
	<i class={ "x", if ok(f`e-@{id}`) { "a" } }></i>
	<i class={ "x", if id > 0 { wrap(f`g-@{id}`) } }></i>
	<i class={ "x", switch wrap(f`h-@{id}`) { case "a": "b" } }></i>
	<i style={ "color: red", wrap(css`width:@{id}px`) }></i>
}
-- invoke --
Page(1)
-- diagnostics.golden --
7:23: an f literal inside a Go expression is not supported in a class part yet; assign it to a variable in a {{ }} block first
7:45: an f literal inside a Go expression is not supported in a class condition yet; assign it to a variable in a {{ }} block first
8:24: an f literal inside a Go expression is not supported in an if condition yet; assign it to a variable in a {{ }} block first
9:35: an f literal inside a Go expression is not supported in a class part yet; assign it to a variable in a {{ }} block first
10:30: an f literal inside a Go expression is not supported in a switch header yet; assign it to a variable in a {{ }} block first
11:32: a css literal inside a Go expression is not supported in a style part yet; assign it to a variable in a {{ }} block first
