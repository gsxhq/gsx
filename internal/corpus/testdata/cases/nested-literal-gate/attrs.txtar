# A gsx literal or element literal nested inside a Go expression is lowered
# only in body `{ }` interpolations and `{{ }}` blocks. Every attribute-side
# Go-expression position reports one positioned nested-literal diagnostic at
# the construct, instead of a raw go/parser "missing ','" from the skeleton.
-- input.gsx --
package demo

import "github.com/gsxhq/gsx"

func wrap(s string) string        { return s }
func wrapN(n gsx.Node) gsx.Node   { return n }
func bag(v string) gsx.Attrs      { return gsx.Attrs{{Key: "data-v", Value: v}} }
func ok(s string) bool            { return s != "" }

component Slot(h gsx.Node, t string, attrs gsx.Attrs) {
	<div { attrs... }>{ h }{ t }</div>
}

component Page(id int) {
	<i title={wrap(f`/z/@{id}`)} data-go={wrap(js`go(@{id})`)}></i>
	<Slot t={wrap(f`t-@{id}`)} data-q={wrap(f`q-@{id}`)}/>
	<Slot h={wrapN(<b>{ id }</b>)}/>
	<i { bag(f`v-@{id}`)... }></i>
	<Slot attrs={{ "data-k": wrap(f`k-@{id}`) }}/>
	<i { if ok(f`c-@{id}`) { title={wrap(f`t-@{id}`)} } }></i>
	<i { switch wrap(f`s-@{id}`) { case "a": title="y" } }></i>
}
-- invoke --
Page(1)
-- diagnostics.golden --
