# A gsx literal nested inside a conditional-attribute condition or an in-tag
# switch header is not lowered yet: each reports one positioned nested-literal
# diagnostic at the construct, instead of a raw go/parser "missing ','" from
# the skeleton. (Attribute values, spreads and attrs-literal values lower: see
# nested-literal/attrs.txtar.)
-- input.gsx --
package demo

func wrap(s string) string { return s }
func ok(s string) bool     { return s != "" }

component Page(id int) {
	<i { if ok(f`c-@{id}`) { title={wrap(f`t-@{id}`)} } }></i>
	<i { switch wrap(f`s-@{id}`) { case "a": title="y" } }></i>
}
-- invoke --
Page(1)
-- diagnostics.golden --
7:13: an f literal inside a Go expression is not supported in a conditional-attribute condition yet; assign it to a variable in a {{ }} block first
8:19: an f literal inside a Go expression is not supported in a switch header yet; assign it to a variable in a {{ }} block first
-- render.golden --
