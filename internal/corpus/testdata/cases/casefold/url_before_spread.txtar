package views

import "github.com/gsxhq/gsx"

component Link(link string, attrs gsx.Attrs) {
	<a href={link} { attrs... }>go</a>
}
-- invoke --
Link("/safe", gsx.Attrs{{Key: "HREF", Value: "javascript:alert(1)"}})
