package views

import "github.com/gsxhq/gsx"

component Box(attrs gsx.Attrs) {
	<div style="--Brand: red; COLOR: green" { attrs... }>box</div>
}

component Page() {
	<Box style="--brand: blue; color: black"/>
	<div style="--A: 1" { gsx.Attrs{{"style", gsx.RawCSS("--a: 2; --A: 3")}}... }>x</div>
}
-- invoke --
Page()
-- diagnostics.golden --
