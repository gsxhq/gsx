# An if-attribute header's init statement follows Go's scoping on a
# SPREAD-FOLDING element — the forwarding bag path, pre-spread (If) and
# post-spread (ElseIf), and the multi-spread fold (Fold): init runs once before
# the condition; its variables are visible to the condition, both branches, and
# an else-if chain with its own init.
-- input.gsx --
package views

import (
	"github.com/gsxhq/gsx"
	"strings"
)

func wrap(s string) string { return strings.ToUpper(s) }

component If(v string, attrs gsx.Attrs) {
	<div { if s := wrap(v); s != "" { title={s} } else { data-empty={s + "!"} } } { attrs... }>x</div>
}

component ElseIf(v string, attrs gsx.Attrs) {
	<p { attrs... } { if s := wrap(v); s == "A" { data-a={s} } else if t := s + s; t != "" { data-t={t + s} } else { data-none={s + t} } }>y</p>
}

component Fold(v string, x gsx.Attrs, y gsx.Attrs) {
	<b { x... } { if s := wrap(v); s == "A" { data-a={s} } else if t := s + s; t != "" { data-t={t + s} } else { data-none={s + t} } } { y... }/>
}

component All() {
	{ If("a", gsx.Attrs{{Key: "id", Value: "i"}}) }
	{ If("", nil) }
	{ ElseIf("a", gsx.Attrs{{Key: "id", Value: "j"}}) }
	{ ElseIf("b", nil) }
	{ ElseIf("", nil) }
	{ Fold("a", gsx.Attrs{{Key: "id", Value: "x"}}, gsx.Attrs{{Key: "lang", Value: "y"}}) }
	{ Fold("b", nil, nil) }
	{ Fold("", nil, nil) }
}
-- invoke --
All()
-- diagnostics.golden --
