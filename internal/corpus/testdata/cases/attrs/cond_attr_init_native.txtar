# An if-attribute header's init statement follows Go's scoping on a NATIVE
# element: the init runs once before the condition, and its variables are in
# scope in the condition, the then/else branch values, and every else-if header
# and body (an else-if may add its own init that uses the outer one).
-- input.gsx --
package views

import (
	"github.com/gsxhq/gsx"
	"strings"
)

func wrap(s string) string { return strings.ToUpper(s) }

component If(v string) {
	<div { if s := wrap(v); s != "" { title={s} } else { data-empty={s + "!"} } }>x</div>
}

component ElseIf(v string) {
	<p { if s := wrap(v); s == "A" { data-a={s} } else if t := s + s; t != "" { data-t={t + s} } else { data-none={s + t} } }>y</p>
}

component All() {
	{ If("a") }
	{ If("") }
	{ ElseIf("a") }
	{ ElseIf("b") }
	{ ElseIf("") }
}

var _ = gsx.Attrs{}
-- invoke --
All()
-- diagnostics.golden --
