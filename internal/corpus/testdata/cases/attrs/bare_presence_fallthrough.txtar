# Syntactically bare attributes retain presence semantics when they are
# collected into an attrs bag, including across nested component forwarding,
# conditional branches, and folded element spreads. The bag leaf applies the
# same name rule an element attribute gets at generate time. data-valued={true}
# renders bare because no vocabulary gives data-valued a value; aria-expanded
# and SVG focusable keep the literal "false", the second proving the curated
# extras reach the leaf too. href={true} pins the leaf against the URL sink:
# presence declares no value, so the sink is inapplicable, and the bag writes a
# bare href like codegen instead of routing through URLVal to href="true".
# gsx.Toggle forces presence regardless of the name.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component Leaf(attrs gsx.Attrs) {
	<div { attrs... }/>
}

component Wrapper(attrs gsx.Attrs) {
	<Leaf { attrs... }/>
}

component Page(show bool, before gsx.Attrs, after gsx.Attrs) {
	<Leaf data-leaf-marker/>
	<Wrapper data-nested-marker/>
	<Leaf data-valued={true}/>
	<Leaf aria-expanded={false}/>
	<Leaf href={true}/>
	<Leaf focusable={false}/>
	<Leaf data-toggle={gsx.Toggle(true)}/>
	<Leaf { if show { data-conditional-marker } }/>
	<div { before... } data-folded-marker { after... }/>
}
-- invoke --
Page(
	true,
	gsx.Attrs{{Key: "data-before", Value: "1"}},
	gsx.Attrs{{Key: "data-after", Value: "2"}},
)
-- diagnostics.golden --
-- render.golden --
<div data-leaf-marker></div><div data-nested-marker></div><div data-valued></div><div aria-expanded="false"></div><div href></div><div focusable="false"></div><div data-toggle></div><div data-conditional-marker></div><div data-before="1" data-folded-marker data-after="2"></div>
