# ONE RULE decides presence-vs-value for a bool-typed value, with no annotation:
# a bool renders as PRESENCE (true → bare, false → omitted) unless HTML's own
# value vocabulary for that name IS the literal strings "true"/"false".
#
# The exception set is the aria-* states plus draggable and spellcheck
# (generated), and contenteditable, writingsuggestions, SVG focusable and MathML
# displaystyle (curated — the dataset is HTML-only). There the string is
# load-bearing: a screen reader announces aria-expanded="false" as collapsed and
# says nothing when the attribute is absent, while contenteditable, spellcheck
# and displaystyle INHERIT, so only the literal "false" opts a subtree out.
#
# sandbox is deliberately NOT an exception: its vocabulary is a token list, so a
# bool means presence. Note the direction — false OMITS it, removing the
# sandbox, where the old rule wrote sandbox="false" and sandboxed everything.
#
# Everything else is presence, including names HTML defines with some other
# vocabulary (title, role) and library names (x-show, hx-boost) — those are
# written as static strings or js`` literals in practice, so a Go bool on one
# can only have meant presence. gsx.Toggle forces presence anywhere; a bare
# attribute is an explicit presence declaration and always toggles.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component Page(on bool) {
	<input required={on} />
	<input checked={on} />
	<div hidden={on}>h</div>
	<div aria-expanded={on}>a</div>
	<div aria-checked={on}>ac</div>
	<div contenteditable={on}>c</div>
	<div spellcheck={on}>s</div>
	<div draggable={on}>dr</div>
	<div title={on}>ti</div>
	<div data-open={on}>d</div>
	<my-toggle active={on}>t</my-toggle>
	<div x-cloak={on}>xc</div>
	<div x-show={on}>x</div>
	<div hx-boost={on}>b</div>
	<svg focusable={on}><circle r="1"/></svg>
	<math displaystyle={on}><mn>1</mn></math>
	<iframe sandbox={on}></iframe>
	<a href={on}>u</a>
	<my-toggle active={gsx.Toggle(on)}>t</my-toggle>
	<input required />
}
-- invoke --
Page(true)
-- diagnostics.golden --
-- render.golden --
<input required><input checked><div hidden>h</div><div aria-expanded="true">a</div><div aria-checked="true">ac</div><div contenteditable="true">c</div><div spellcheck="true">s</div><div draggable="true">dr</div><div title>ti</div><div data-open>d</div><my-toggle active>t</my-toggle><div x-cloak>xc</div><div x-show>x</div><div hx-boost>b</div><svg focusable="true"><circle r="1"></circle></svg><math displaystyle="true"><mn>1</mn></math><iframe sandbox></iframe><a href>u</a><my-toggle active>t</my-toggle><input required>
