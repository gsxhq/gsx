# An error-carrying hole in an if-attribute header's init statement on a
# SPREAD-FOLDING element (post-spread): the init's error returns from Render
# before the condition runs, and on success its value is in scope in the
# branch.
-- input.gsx --
package views

import (
	"errors"
	"github.com/gsxhq/gsx"
)

func mayFail(s string) (string, error) {
	if s == "bad" {
		return "", errors.New("init failed")
	}
	return s, nil
}

component Box(attrs gsx.Attrs) { <i { attrs... }/> }

component C(v string, attrs gsx.Attrs) {
	<i { attrs... } { if s := f"<@{mayFail(v)}>"; s != "<>" { title={s} } }/>
}

component All() {
	{ C("a", nil) }
	{ C("", nil) }
	{ C("bad", nil) }
}
-- invoke --
All()
-- diagnostics.golden --
-- render.golden --
<i title="&lt;a&gt;"></i><i></i><i
[render error] init failed
