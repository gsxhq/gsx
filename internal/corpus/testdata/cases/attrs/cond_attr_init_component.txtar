# An if-attribute header's init statement follows Go's scoping on a COMPONENT
# tag (the attrs-bag thunk path): init runs once before the condition; its
# variables are visible to the condition, both branches, and an else-if chain
# with its own init.
-- input.gsx --
package views

import (
	"github.com/gsxhq/gsx"
	"strings"
)

func wrap(s string) string { return strings.ToUpper(s) }

component Box(attrs gsx.Attrs) { <div { attrs... }>x</div> }

component If(v string) {
	<Box { if s := wrap(v); s != "" { title={s} } else { data-empty={s + "!"} } }/>
}

component ElseIf(v string) {
	<Box { if s := wrap(v); s == "A" { data-a={s} } else if t := s + s; t != "" { data-t={t + s} } else { data-none={s + t} } }/>
}

component All() {
	{ If("a") }
	{ If("") }
	{ ElseIf("a") }
	{ ElseIf("b") }
	{ ElseIf("") }
}
-- invoke --
All()
