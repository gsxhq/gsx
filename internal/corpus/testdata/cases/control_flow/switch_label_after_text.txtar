A case body ending in bare text (no trailing element) no longer swallows the
next arm's `default:` label as literal text (2026-07-25 fix). Selecting the
text-only arm renders only its own text, not the label that follows it.
-- input.gsx --
package views

component Pick(k string) {
	<div>{ switch k {
	case "a":
		tail
	default:
		<i>y</i>
	} }</div>
}
-- invoke --
Pick("a")
-- diagnostics.golden --
-- render.golden --
<div>tail</div>
