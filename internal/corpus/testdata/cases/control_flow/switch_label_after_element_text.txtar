The design doc's motivating example: an arm ending in an element FOLLOWED by
bare trailing text (not text alone) must also stop before the next label.
-- input.gsx --
package views

component Pick2(k string) {
	<div>{ switch k {
	case "a":
		<b>x</b> tail
	default:
		<i>y</i>
	} }</div>
}
-- invoke --
Pick2("a")
-- diagnostics.golden --
-- render.golden --
<div><b>x</b> tail</div>
