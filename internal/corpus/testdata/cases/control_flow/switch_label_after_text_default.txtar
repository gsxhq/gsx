Sibling of switch_label_after_text.txtar: same source, selecting the default
arm proves the `default:` label was actually parsed as a real arm (not
swallowed into the previous arm's text) and its own body renders.
-- input.gsx --
package views

component Pick(k string) {
	<div>{ switch k {
	case "a":
		tail
	default:
		<i>y</i>
	} }</div>
}
-- invoke --
Pick("other")
-- diagnostics.golden --
-- render.golden --
<div><i>y</i></div>
