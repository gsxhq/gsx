# The hoist inside an init-statement header block propagates its error:
# lookup(len(s) - 4) fails for s == "q-1".
-- input.gsx --
package demo

import "errors"

func wrap(s string) string { return s }
func ok(s string) bool     { return s != "" }
func lookup(id int) (string, error) {
	if id < 0 {
		return "", errors.New("bad id")
	}
	return "L", nil
}

component Page(id int) {
	<b>start</b>
	{ if s := wrap(f`q-@{id}`); ok(f`@{lookup(len(s) - 4)}`) {
		<b>{ s }</b>
	} }
}
-- invoke --
Page(1)
-- diagnostics.golden --
-- render.golden --
<b>start</b>
[render error] bad id
