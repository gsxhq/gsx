# An element literal nested in an attribute value's Go expression (component
# input, also nested in a further element's input) is whitespace-normalized
# like one in top-level Go, the same as the whole-value form h={<b>…</b>}.
-- input.gsx --
package demo

import "github.com/gsxhq/gsx"

func wrapN(n gsx.Node) gsx.Node { return n }

component Holder(h gsx.Node, attrs gsx.Attrs) {
	<div { attrs... }>{ h }</div>
}

component Page(n int) {
	<Holder h={wrapN(<b>  a   b  </b>)}/>
	<Holder h={<b>  a   b  </b>}/>
	<Holder h={wrapN(
		<b>
			{ n }
			<i/>
		</b>,
	)}/>
	<Holder h={wrapN(<Holder h={wrapN(<b>  c   d  </b>)}/>)}/>
}
-- invoke --
Page(1)
-- diagnostics.golden --
-- render.golden --
<div><b> a b </b></div><div><b> a b </b></div><div><b>1<i></i></b></div><div><div><b> c d </b></div></div>
