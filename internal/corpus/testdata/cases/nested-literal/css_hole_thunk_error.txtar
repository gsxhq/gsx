# An error-carrying hole in a literal nested inside a css`…` style part hoists
# with the enclosing function's error return. On a spread element the
# conditional attribute is an AttrsCond thunk returning (Attrs, error), so the
# hoist is `return nil, _gsxerr`. Page(-1) fails inside the thunk and the
# render stops there.
-- input.gsx --
package demo

import (
	"errors"

	"github.com/gsxhq/gsx"
)

func wrap(s string) string { return s }
func lookup(id int) (string, error) {
	if id < 0 {
		return "", errors.New("bad id")
	}
	return "L", nil
}

component Page(id int, a gsx.Attrs) {
	<i { a... } { if id != 0 { style={ css`h:@{wrap(f`@{lookup(id)}`)}px` } } }></i>
	<i { a... } { if id != 0 { style={ "a: b", css`w:@{lookup(id)}px` } } }></i>
	<i { a... } { if id != 0 { style={ if id != 2 { css`t:@{wrap(f`@{lookup(id)}`)}px` } } } }></i>
}

component All() {
	<Page id={1} a={nil}/>
	<Page id={-1} a={nil}/>
}
-- invoke --
All()
-- diagnostics.golden --
-- render.golden --
<i style="h:Lpx"></i><i style="a: b; w:Lpx"></i><i style="t:Lpx"></i>
[render error] bad id
-- generated.x.go.golden --
