# Error-carrying holes in literals nested in class/style positions hoist with
# the enclosing function's return shape: element class/style parts and guards
# (before the write), value-form arms (inside their own branch), if conditions
# and switch tags (before the if/switch), a component class (before the call),
# and a class in a component cond-attr branch (inside the AttrsCond thunk,
# `return nil, _gsxerr`). An `else if` whose condition hoists is emitted as
# `else { <hoist>; if … }`: its lookup(-1) must never run here, because the
# first branch is taken.
-- input.gsx --
package demo

import (
	"errors"

	"github.com/gsxhq/gsx"
)

func wrap(s string) string              { return s }
func ok(s string) bool                  { return s != "" }
func wrapCSS(c gsx.RawCSS) gsx.RawCSS { return c }
func lookup(id int) (string, error) {
	if id < 0 {
		return "", errors.New("bad id")
	}
	return "L", nil
}

component Box(attrs gsx.Attrs) {
	<b { attrs... }></b>
}

component Page(id int) {
	<i class={ "x", wrap(f`a-@{lookup(id)}`), "g": ok(f`@{lookup(id)}`) }></i>
	<i class={ "x", if id > 0 { wrap(f`b-@{lookup(id)}`) } }></i>
	<i class={ "x", if ok(f`@{lookup(id)}`) { "c" } }></i>
	<i class={ "x", if id > 0 { "p" } else if ok(f`@{lookup(-1)}`) { "q" } }></i>
	<i class={ "x", if id < 0 { "p" } else if ok(f`@{lookup(id)}`) { "q" } }></i>
	<i class={ "x", switch wrap(f`@{lookup(id)}`) { case "L": "s" } }></i>
	<i style={ "color: red", wrapCSS(css`width:@{lookup(id)}px`) }></i>
	<Box class={ "x", wrap(f`k-@{lookup(id)}`), if id > 0 { "p" } else if ok(f`@{lookup(-1)}`) { "q" } }/>
	<Box { if id > 0 { class={ wrap(f`t-@{lookup(id)}`) } } }/>
	<Box { if id > 0 { class={ if ok(f`@{lookup(id)}`) { wrap(f`u-@{lookup(id)}`) } } } }/>
	<i style={ if id > 0 { wrapCSS(css`height:@{lookup(id)}px`) } }></i>
}
-- invoke --
Page(1)
-- diagnostics.golden --
-- render.golden --
<i class="x a-L g"></i><i class="x b-L"></i><i class="x c"></i><i class="x p"></i><i class="x q"></i><i class="x s"></i><i style="color: red; width:Lpx"></i><b class="x k-L p"></b><b class="t-L"></b><b class="u-L"></b><i style="height:Lpx"></i>
