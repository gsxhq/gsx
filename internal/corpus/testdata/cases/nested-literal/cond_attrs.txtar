# A gsx literal nested in a conditional-attribute condition, an in-tag switch
# tag or its case list lowers in place, on native elements and component tags.
# Laziness: the `else if` after a taken branch dereferences a nil *U and never
# runs.
-- input.gsx --
package demo

import "github.com/gsxhq/gsx"

type U struct{ Name string }

func wrap(s string) string { return s }
func ok(s string) bool     { return s != "" }

component Box(attrs gsx.Attrs) {
	<b { attrs... }>box</b>
}

component Page(id int, u *U) {
	<i { if ok(f`@{id}`) { title="y" } else if ok(f`@{u.Name}`) { title="z" } }></i>
	<i { switch wrap(f`s-@{id}`) { case "s-1": data-s="y" } }></i>
	<i { switch { case ok(f`c-@{id}`): data-c="y" } }></i>
	<Box { if ok(f`@{id}`) { title="y" } else if ok(f`@{u.Name}`) { title="z" } }/>
	<Box { switch wrap(f`s-@{id}`) { case "s-1": data-s="y" } }/>
	<Box { switch { case ok(f`c-@{id}`): data-c="y" } }/>
}
-- invoke --
Page(1, nil)
