# An error-carrying hole in a reached `else if` condition propagates: the
# render returns lookup's error.
-- input.gsx --
package demo

import "errors"

func ok(s string) bool { return s != "" }
func lookup(id int) (string, error) {
	if id < 0 {
		return "", errors.New("bad id")
	}
	return "L", nil
}

component Page(id int) {
	<b>start</b>
	{ if id == 2 {
		<b>two</b>
	} else if ok(f`@{lookup(id)}`) {
		<b>reached</b>
	} }
}
-- invoke --
Page(-1)
-- diagnostics.golden --
-- render.golden --
<b>start</b>
[render error] bad id
