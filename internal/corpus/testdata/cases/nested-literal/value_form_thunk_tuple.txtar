# Style value-form arms whose lowering hoists an error — a (T, error) arm, a
# piped arm with an error-returning mid stage, and an arm rendered by an
# error-returning renderer — inside an element-fold AttrsCond thunk hoist with
# the thunk's `return nil, _gsxerr`. Page(-1) fails inside the first thunk and
# the render stops there.
-- gsx.toml --
filter_packages = ["./filters"]

[renderers]
"./px.Len" = "./rend.Len"
-- filters/filters.go --
package filters

import "errors"

// Check fails on a negative id.
func Check(id int) (int, error) {
	if id < 0 {
		return 0, errors.New("check: negative")
	}
	return id, nil
}

// Decl formats a width declaration.
func Decl(id int) string {
	if id == 1 {
		return "w: 1px"
	}
	return "w: 2px"
}
-- px/px.go --
package px

type Len int
-- rend/rend.go --
package rend

import (
	"errors"

	"corpustest/cases/nested-literal_value_form_thunk_tuple/px"
)

func Len(l px.Len) (string, error) {
	if l < 0 {
		return "", errors.New("len: negative")
	}
	if l == 1 {
		return "m: 1px", nil
	}
	return "m: 2px", nil
}
-- input.gsx --
package demo

import (
	"errors"

	"github.com/gsxhq/gsx"

	"corpustest/cases/nested-literal_value_form_thunk_tuple/px"
)

func tup(id int) (string, error) {
	if id < 0 {
		return "", errors.New("bad id")
	}
	return "h: 1px", nil
}

component Page(id int, a gsx.Attrs) {
	<i { a... } { if id != 0 { style={ if id != 2 { tup(id) } } } }></i>
	<i { a... } { if id != 0 { style={ "a: b", switch id { case 3: "c: d" default: tup(id) } } } }></i>
	<i { a... } { if id != 0 { style={ if id != 2 { id |> check |> decl } } } }></i>
	<i { a... } { if id != 0 { style={ if id != 2 { px.Len(id) } } } }></i>
}

component All() {
	<Page id={1} a={nil}/>
	<Page id={-1} a={nil}/>
}
-- invoke --
All()
-- diagnostics.golden --
