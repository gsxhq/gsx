# An element or fragment literal inside a {{ }} block is a gsx.Node value,
# exactly like one in top-level Go: operand of a call, a bare fragment, one
# built per loop iteration capturing the loop variable, one passed on to a
# component slot prop, and one whose own attribute nests an f literal.
-- input.gsx --
package demo

import "github.com/gsxhq/gsx"

func wrapN(n gsx.Node) gsx.Node { return n }

component Slot(h gsx.Node) {
	<div>{ h }</div>
}

component Page(id int, xs []string) {
	{{ n := wrapN(<b>{ id }</b>) }}
	<p>{ n }</p>
	{{ m := <><i>a</i><i>{ id }</i></> }}
	<p>{ m }</p>
	{ for _, x := range xs {
		{{ e := <em>{ x }</em> }}
		<p>{ e }</p>
	} }
	{{ s := <u>{ id }</u> }}
	<Slot h={s}/>
	{{ a := <a href={f`/p/@{id}`} title={wrap(f`t-@{id}`)}>link</a> }}
	<p>{ a }</p>
}

func wrap(s string) string { return s }
-- invoke --
Page(7, []string{"x", "y"})
-- diagnostics.golden --
-- render.golden --
<p><b>7</b></p><p><i>a</i><i>7</i></p><p><em>x</em></p><p><em>y</em></p><div><u>7</u></div><p><a href="/p/7" title="t-7">link</a></p>
