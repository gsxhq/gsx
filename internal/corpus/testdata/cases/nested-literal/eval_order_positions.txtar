# The left-to-right pinning around a hoisted error-carrying hole holds in
# every position that hoists: an attribute value, a component input, a class
# part and guard, an if condition (after its init statement), a switch tag, a
# value-form arm, a native and a component conditional-attribute branch (inside
# the branch / the AttrsCond thunk), a spread, an attrs-literal pair, a literal
# nested in another literal's hole, a js` literal, a literal whose own earlier
# hole is pinned after the field's operands, two hoisting literals with a call
# between them, an element literal inside a pinned call, a conditional
# attribute's condition and switch tag, a value-form if condition and switch
# tag, an else-if header with an init statement, a marker name, and <script>
# and <style> holes, a component's conditional-attribute condition, and
# (across fields, already ordered) an earlier attribute's call, and an
# interpolation inside an element literal in top-level Go, and a piped
# interpolation. Each line
# records the order its calls ran in; every line reads g (or 1/mid) before 2.
-- input.gsx --
package demo

import (
	"strings"

	"github.com/gsxhq/gsx"
)

type rec struct{ log []string }

func (r *rec) F(s string) string { r.log = append(r.log, s); return s }
func (r *rec) E(s string) (string, error) { r.log = append(r.log, s); return s, nil }
func (r *rec) B(s string) bool { r.log = append(r.log, s); return true }
func (r *rec) N(s string, n gsx.Node) string { r.log = append(r.log, s); return s }
func (r *rec) String() string { return strings.Join(r.log, ",") }

func join(a, b string) string       { return a + "|" + b }
func join3(a, b, c string) string   { return a + "|" + b + "|" + c }
func yes(b bool, s string) bool     { return b && s != "" }
func bag(a, b string) gsx.Attrs     { return gsx.Attrs{{Key: "data-v", Value: a + b}} }
func wrap(s string) string          { return s }

func item(r *rec) gsx.Node {
	return <u>{ join(r.F("g"), f`@{r.E("2")}`) }</u>
}

component Show(v string) {
	<b>{ v }</b>
}

component Box(attrs gsx.Attrs) {
	<b { attrs... }></b>
}

component Page(on bool) {
	{{ r := &rec{} }}
	<i title={join(r.F("g"), f`b-@{r.E("2")}`)}></i>{ r }
	{{ r = &rec{} }}
	<Show v={join(r.F("g"), f`b-@{r.E("2")}`)}/>{ r }
	{{ r = &rec{} }}
	<i class={ "x", join(r.F("g"), f`b-@{r.E("2")}`) }></i>{ r }
	{{ r = &rec{} }}
	<i class={ "x", "k": yes(r.B("g"), f`@{r.E("2")}`) }></i>{ r }
	{{ r = &rec{} }}
	{ if s := r.F("init"); yes(r.B("g"), f`@{r.E("2")}`) && s != "" {
		<b>if</b>
	} }{ r }
	{{ r = &rec{} }}
	{ switch join(r.F("g"), f`@{r.E("2")}`) {
	case "g|2":
		<b>sw</b>
	} }{ r }
	{{ r = &rec{} }}
	<i class={ "x", if on { join(r.F("g"), f`b-@{r.E("2")}`) } }></i>{ r }
	{{ r = &rec{} }}
	<i { if on { title={join(r.F("g"), f`b-@{r.E("2")}`)} } }></i>{ r }
	{{ r = &rec{} }}
	<Box { if on { data-c={join(r.F("g"), f`c-@{r.E("2")}`)} } }/>{ r }
	{{ r = &rec{} }}
	<i { bag(r.F("g"), f`@{r.E("2")}`)... }></i>{ r }
	{{ r = &rec{} }}
	<Box attrs={{ "data-d": join(r.F("g"), f`d-@{r.E("2")}`) }}/>{ r }
	{{ r = &rec{} }}
	{ wrap(f`x-@{join(r.F("g"), f`@{r.E("2")}`)}`) } { r }
	{{ r = &rec{} }}
	{ join(r.F("g"), string(js`f(@{r.E("2")})`)) } { r }
	{{ r = &rec{} }}
	{ join(r.F("g"), f`@{r.F("p")}-@{r.E("2")}`) } { r }
	{{ r = &rec{} }}
	{ join3(f`@{r.E("1")}`, r.F("mid"), f`@{r.E("2")}`) } { r }
	{{ r = &rec{} }}
	{ join(r.N("g", <b>{ r.F("later") }</b>), f`@{r.E("2")}`) } { r }
	{{ r = &rec{} }}
	<i { if yes(r.B("g"), f`@{r.E("2")}`) { title="c" } }></i>{ r }
	{{ r = &rec{} }}
	<i { switch join(r.F("g"), f`@{r.E("2")}`) { case "g|2": data-s="s" } }></i>{ r }
	{{ r = &rec{} }}
	<i class={ "x", if yes(r.B("g"), f`@{r.E("2")}`) { "vi" } }></i>{ r }
	{{ r = &rec{} }}
	<i class={ "x", switch join(r.F("g"), f`@{r.E("2")}`) { case "g|2": "vs" } }></i>{ r }
	{{ r = &rec{} }}
	{ if !on {
		<b>no</b>
	} else if s := r.F("init"); yes(r.B("g"), f`@{r.E("2")}`) && s != "" {
		<b>elif</b>
	} }{ r }
	{{ r = &rec{} }}
	<?marker name={join(r.F("g"), f`m-@{r.E("2")}`)}>{ r }
	{{ r = &rec{} }}
	<script>var s = @{ join(r.F("g"), f`@{r.E("2")}`) };</script>{ r }
	{{ r = &rec{} }}
	<style>p { width: @{ join(r.F("g"), f`@{r.E("2")}`) }; }</style>{ r }
	{{ r = &rec{} }}
	<Box { if yes(r.B("g"), f`@{r.E("2")}`) { title="c" } }/>{ r }
	{{ r = &rec{} }}
	<i title={r.F("g")} data-b={wrap(f`@{r.E("2")}`)}></i>{ r }
	{{ r = &rec{} }}
	<Show v={r.F("g") + wrap(f`@{r.E("2")}`)}/>{ r }
	{{ r = &rec{} }}
	{ item(r) }{ r }
	{{ r = &rec{} }}
	<p>{ join(r.F("g"), f`@{r.E("2")}`) |> upper } { r }</p>
}
-- invoke --
Page(true)
