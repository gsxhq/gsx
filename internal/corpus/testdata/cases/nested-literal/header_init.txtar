# An if/switch header with an init statement whose condition needs a hoist is
# emitted as `{ <init>; <hoist>; if <cond> {…} }`, so the hoist can use the
# init's variables: markup if (and an else-if), markup switch, conditional
# attribute, in-tag switch, component-tag switch and value-form if (and an
# else-if, written `else { <init>; <hoist>; if … }`); a chain whose trailing
# else uses the init variable.
-- input.gsx --
package demo

import (
	"errors"

	"github.com/gsxhq/gsx"
)

func wrap(s string) string { return s }
func ok(s string) bool     { return s != "" }
func lookup(id int) (string, error) {
	if id < 0 {
		return "", errors.New("bad id")
	}
	return "L", nil
}

component Box(attrs gsx.Attrs) {
	<b { attrs... }>box</b>
}

component Page(id int) {
	{ if s := wrap(f`q-@{id}`); ok(f`@{lookup(len(s))}`) {
		<b>{ s }</b>
	} }
	{ if id == 2 {
		<b>two</b>
	} else if s := wrap(f`e-@{id}`); ok(f`@{lookup(len(s))}`) {
		<b>{ s }</b>
	} }
	{ if s := wrap(f`a-@{id}`); !ok(f`@{lookup(len(s))}`) {
		<b>never</b>
	} else if !ok(f`@{lookup(len(s))}`) {
		<b>never</b>
	} else {
		<b>else { s }</b>
	} }
	{ switch n := id * 2; f`@{lookup(n)}` {
	case "L":
		<b>sw</b>
	} }
	<i { if n := id; ok(f`@{lookup(n)}`) { title="cond" } }></i>
	<i { switch n := id; f`@{lookup(n)}` { case "L": data-s="sw" } }></i>
	<Box { switch n := id; f`@{lookup(n)}` { case "L": data-s="comp" } }/>
	<i class={ "x", if n := id; ok(f`@{lookup(n)}`) { "vf" } }></i>
	<i class={ "x", if id == 2 { "two" } else if n := id; ok(f`@{lookup(n)}`) { "vf2" } }></i>
}
-- invoke --
Page(1)
-- diagnostics.golden --
-- render.golden --
<b>q-1</b><b>e-1</b><b>else a-1</b><b>sw</b><i title="cond"></i><i data-s="sw"></i><b data-s="comp">box</b><i class="x vf"></i><i class="x vf2"></i>
