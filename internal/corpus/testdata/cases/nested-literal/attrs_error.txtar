# An error-carrying hole in a literal nested in an attribute value hoists
# before the attribute's write and propagates: lookup(-1) fails, so the render
# returns its error.
-- input.gsx --
package demo

import "errors"

func wrap(s string) string { return s }
func lookup(id int) (string, error) {
	if id < 0 {
		return "", errors.New("bad id")
	}
	return "L", nil
}

component Page(id int) {
	<i data-l={wrap(f`l-@{lookup(id)}`)}></i>
}
-- invoke --
Page(-1)
-- diagnostics.golden --
-- render.golden --
<i
[render error] bad id
