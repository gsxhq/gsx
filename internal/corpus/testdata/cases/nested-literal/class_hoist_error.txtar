# An error-carrying hole in a literal nested in a value-form if condition
# hoists before the `if` and propagates: lookup(-1) fails, so the render
# returns its error.
-- input.gsx --
package demo

import "errors"

func ok(s string) bool { return s != "" }
func lookup(id int) (string, error) {
	if id < 0 {
		return "", errors.New("bad id")
	}
	return "L", nil
}

component Page(id int) {
	<i class={ "x", if ok(f`@{lookup(id)}`) { "c" } }></i>
}
-- invoke --
Page(-1)
-- diagnostics.golden --
-- render.golden --
<i
[render error] bad id
