# An error-carrying hole in a literal nested in an if condition or a switch tag
# hoists immediately before the `if`/`switch`; an `else if` is emitted as
# `else { <hoist>; if … }`, so after a taken branch its hole (lookup(-1), which
# would fail) never runs. Element literals lower in if conditions and case
# lists, and a pure hole in a for condition is re-evaluated every iteration.
-- input.gsx --
package demo

import (
	"errors"

	"github.com/gsxhq/gsx"
)

func ok(s string) bool        { return s != "" }
func isNode(n gsx.Node) bool  { return n != nil }
func lookup(id int) (string, error) {
	if id < 0 {
		return "", errors.New("bad id")
	}
	return "L", nil
}

component Page(id int) {
	{ if ok(f`@{lookup(id)}`) {
		<b>if</b>
	} }
	{ if id == 1 {
		<b>one</b>
	} else if ok(f`@{lookup(-1)}`) {
		<b>never</b>
	} }
	{ if id == 2 {
		<b>two</b>
	} else if ok(f`@{lookup(id)}`) {
		<b>reached</b>
	} }
	{ switch ok(f`@{lookup(id)}`) {
	case true:
		<b>sw</b>
	} }
	{ if isNode(<i>{ id }</i>) {
		<b>elem</b>
	} }
	{ switch {
	case isNode(<i/>):
		<b>case-elem</b>
	} }
	{ for i := 0; len(f`@{i}`) == 1 && i < 3; i++ {
		<b>{ i }</b>
	} }
}
-- invoke --
Page(1)
-- diagnostics.golden --
-- render.golden --
<b>if</b><b>one</b><b>reached</b><b>sw</b><b>elem</b><b>case-elem</b><b>0</b><b>1</b><b>2</b>
