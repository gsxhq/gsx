# Nested literals in class/style parts, their `: cond` guards, value-form
# if/switch headers and arms. Laziness: the `if u != nil` arm, the `else if`
# after a true `if`, and the second case (the first matches) all dereference a
# nil u and must never evaluate. A css literal is gsx.RawCSS, so the style part
# wraps it in a RawCSS-typed helper (StyleValue passes RawCSS verbatim). The
# last two lines nest a literal inside a hole of a css/f literal part and arm.
-- input.gsx --
package demo

import "github.com/gsxhq/gsx"

type U struct{ Name string }

func wrap(s string) string              { return s }
func ok(s string) bool                  { return s != "" }
func wrapCSS(c gsx.RawCSS) gsx.RawCSS { return c }

component Page(id int, u *U) {
	<i class={ "x", wrap(f`c-@{id}`), "on": ok(f`d-@{id}`) }></i>
	<i class={ "x", if ok(f`e-@{id}`) { "a" } }></i>
	<i class={ "x", if u != nil { wrap(f`g-@{u.Name}`) } }></i>
	<i class={ "x", if id > 0 { "p" } else if ok(f`h-@{u.Name}`) { "q" } }></i>
	<i class={ "x", switch wrap(f`s-@{id}`) { case "s-1": "b" } }></i>
	<i class={ "x", switch { case id == 1: "n" case ok(f`k-@{u.Name}`): "m" } }></i>
	<i style={ "color: red", wrapCSS(css`width:@{id}px`) }></i>
	<i style={ css`height:@{wrap(f`@{id}`)}px`, if id > 0 { css`top:@{wrap(f`@{id}`)}px` } }></i>
	<i class={ "x", if id > 0 { f`y-@{wrap(f`@{id}`)}` } }></i>
}
-- invoke --
Page(1, nil)
-- diagnostics.golden --
-- render.golden --
<i class="x c-1 on"></i><i class="x a"></i><i class="x"></i><i class="x p"></i><i class="x b"></i><i class="x n"></i><i style="color: red; width:1px"></i><i style="height:1px; top:1px"></i><i class="x y-1"></i>
