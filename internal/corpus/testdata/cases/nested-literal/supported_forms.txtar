# The forms the nested-literal diagnostics point to, plus the whole-value
# literals that were never nested: a braced literal that is the entire
# attribute value, a literal bound in a {{ }} block then passed on, and an
# element literal built in a top-level Go function.
-- input.gsx --
package demo

import "github.com/gsxhq/gsx"

func wrap(s string) string      { return s }
func wrapN(n gsx.Node) gsx.Node { return n }
func boldID(id int) gsx.Node    { return wrapN(<b>{ id }</b>) }

component Slot(h gsx.Node, t string) {
	<div>{ h }{ t }</div>
}

component Page(id int) {
	<i title={f`/z/@{id}`} @click={js`go(@{id})`} data-x={ f`a-@{id}` |> upper }></i>
	<Slot t={f`t-@{id}`} h={boldID(id)}/>
	{{ t := f`/w/@{id}` }}
	<i title={wrap(t)}>{ wrap(f`/b/@{id}`) }</i>
}
-- invoke --
Page(1)
-- diagnostics.golden --
-- render.golden --
<i title="/z/1" @click="go( 1 )" data-x="A-1"></i><div><b>1</b>t-1</div><i title="/w/1">/b/1</i>
