# An element literal nested in a body interpolation's Go expression gets the
# same whitespace normalization and tag serialization as one in top-level Go:
# runs collapse, multi-line indentation drops, a <pre> inside keeps its text,
# a <pre> around the interpolation does not leak into the Go expression, and
# <i/> expands canonically.
-- input.gsx --
package demo

import "github.com/gsxhq/gsx"

func wrapN(n gsx.Node) gsx.Node { return n }

component Page(n int) {
	<p>{ wrapN(<b>  a   b  </b>) }</p>
	<p>{ wrapN(
		<b>
			{ n }
			<i/>
		</b>,
	) }</p>
	<p>{ wrapN(<pre>  x   y  </pre>) }</p>
	<pre>{ wrapN(<b>  c   d  </b>) }</pre>
}
-- invoke --
Page(1)
-- diagnostics.golden --
-- render.golden --
<p><b> a b </b></p><p><b>1<i></i></b></p><p><pre>  x   y  </pre></p><pre><b> c d </b></pre>
