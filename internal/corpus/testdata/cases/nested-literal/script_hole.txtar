# A literal nested in a <script> @{ } hole lowers to its Go value, and that
# value takes the hole's own JS escaping: a string is JSON-encoded in value
# position and string-escaped inside a quoted string, a js` literal stays
# trusted RawJS, and an error-carrying hole inside the literal is returned
# from Render.
-- input.gsx --
package demo

import (
	"errors"

	"github.com/gsxhq/gsx"
)

func wrap(s string) string        { return s }
func wrapJ(j gsx.RawJS) gsx.RawJS { return j }
func lookup(id int) (string, error) {
	if id < 0 {
		return "", errors.New("bad id")
	}
	return "L", nil
}

component Page(n int) {
	<script>var a = @{ wrap(f`a@{n}"`) };</script>
	<script>var b = "@{ wrap(f`b@{n}"`) }";</script>
	<script>var c = @{ wrapJ(js`go(@{n})`) };</script>
	<script>var d = @{ f`d@{n}` };</script>
	<script>var e = @{ wrap(f`e-@{lookup(n)}`) };</script>
}
-- invoke --
Page(1)
