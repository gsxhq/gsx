# A literal on the LEFT of && (or anywhere evaluated unconditionally) hoists
# its error-carrying hole before the `if`, and a pure hole on the right of &&
# lowers in place, so the nil *U is never dereferenced.
-- input.gsx --
package demo

import "errors"

type U struct{ Name string }

func ok(s string) bool { return s != "" }
func lookup(id int) (string, error) {
	if id < 0 {
		return "", errors.New("bad id")
	}
	return "L", nil
}

component Page(id int, u *U) {
	{ if ok(f`@{lookup(id)}`) && id > 0 {
		<b>left</b>
	} }
	{ if u != nil && len(string(js`f(@{u.Name})`)) > 0 {
		<b>never</b>
	} }
	<i { if u != nil && ok(string(css`c:@{u.Name}`)) { title="never" } }></i>
}
-- invoke --
Page(1, nil)
-- diagnostics.golden --
-- render.golden --
<b>left</b><i></i>
