# A gsx literal nested in a control-flow header lowers in place: an if
# condition (with an init statement), a for clause, a switch tag and a case
# list; a js or css literal is gsx.RawJS / gsx.RawCSS, hence string(…).
# Laziness: the `else if` after a taken branch and the case list after a
# matched case dereference a nil *U and never run.
-- input.gsx --
package demo

type U struct{ Name string }

func wrap(s string) string { return s }
func ok(s string) bool     { return s != "" }

component Page(id int, u *U) {
	{ if s := wrap(f`q-@{id}`); s != "" {
		<b>{ s }</b>
	} else if ok(f`r-@{u.Name}`) {
		<i>never</i>
	} }
	{ for _, s := range []string{wrap(f`r-@{id}`), string(css`c:@{id}`)} {
		<b>{ s }</b>
	} }
	{ switch string(js`s(@{id})`) {
	case "s( 1 )":
		<b>js</b>
	} }
	{ switch {
	case id == 1:
		<b>first</b>
	case ok(f`t-@{u.Name}`):
		<b>never</b>
	} }
}
-- invoke --
Page(1, nil)
-- diagnostics.golden --
-- render.golden --
<b>q-1</b><b>r-1</b><b>c:1</b><b>js</b><b>first</b>
-- generated.x.go.golden --
