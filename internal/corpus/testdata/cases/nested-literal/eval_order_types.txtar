# Pinning before a hoisted hole consults go/types (the skeleton's facts): a
# constant call (min over untyped constants, len of a constant in an array
# length) evaluates nothing and stays in place — a temp would give it its
# default type or make the length non-constant; a conversion stays in place
# while the call inside it is pinned; a logical operation over comparisons is
# an untyped boolean, so where the context converts it to a defined boolean
# type its temp is compared with true to stay untyped; a called func literal
# and a generic call are pinned like any call. Nothing inside a constant is
# evaluated (unsafe.Sizeof's operand), so nothing inside it is pinned.
-- input.gsx --
package demo

import (
	"strings"
	"unsafe"
)

type rec struct{ log []string }

func (r *rec) F(s string) string { r.log = append(r.log, s); return s }
func (r *rec) E(s string) (string, error) { r.log = append(r.log, s); return s, nil }
func (r *rec) String() string { return strings.Join(r.log, ",") }

type Flag bool

func join(a, b string) string            { return a + "|" + b }
func f32(x float32, s string) string     { return s }
func arr(a [3]int, s string) string      { return s }
func flag(f Flag, s string) string       { return s }
func yes(b bool, s string) string        { return s }
func id[T any](v T) T                    { return v }
func size(n uintptr, s string) string    { return s }

component Page() {
	{{ r := &rec{} }}
	<p>{ f32(min(1, 2.5), f`@{r.E("2")}`) } { r }</p>
	{{ r = &rec{} }}
	<p>{ arr([len("abc")]int{}, f`@{r.E("2")}`) } { r }</p>
	{{ r = &rec{} }}
	<p>{ join(string([]byte(r.F("g"))), f`@{r.E("2")}`) } { r }</p>
	{{ r = &rec{} }}
	<p>{ flag(r.F("a") == "a" && r.F("b") == "b", f`@{r.E("2")}`) } { r }</p>
	{{ r = &rec{} }}
	<p>{ yes(r.F("a") == "a" && r.F("b") == "b", f`@{r.E("2")}`) } { r }</p>
	{{ r = &rec{} }}
	<p>{ join(func() string { return r.F("iife") }(), f`@{r.E("2")}`) } { r }</p>
	{{ r = &rec{} }}
	<p>{ join(id[string](r.F("gen")), f`@{r.E("2")}`) } { r }</p>
	{{ r = &rec{} }}
	<p>{ size(unsafe.Sizeof(r.F("never")), f`@{r.E("2")}`) } { r }</p>
}
-- invoke --
Page()
-- diagnostics.golden --
-- render.golden --
<p>2 2</p><p>2 2</p><p>g|2 g,2</p><p>2 a,b,2</p><p>2 a,b,2</p><p>iife|2 iife,2</p><p>gen|2 gen,2</p><p>2 2</p>
