# An element literal in a {{ }} block is whitespace-normalized exactly like an
# element literal in top-level Go, directly and nested in a call.
-- input.gsx --
package demo

import "github.com/gsxhq/gsx"

func wrapN(n gsx.Node) gsx.Node { return n }

var top = <b>  a   b  </b>

component Page(n int) {
	{{ el := <b>  a   b  </b> }}
	{{ w := wrapN(
		<b>
			{ n }
			<i/>
		</b>,
	) }}
	{ top }{ el }{ w }
}
-- invoke --
Page(1)
-- diagnostics.golden --
-- render.golden --
<b> a b </b><b> a b </b><b>1<i></i></b>
