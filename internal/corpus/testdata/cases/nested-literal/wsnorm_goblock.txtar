# Embedded element literals preserve exact HTML content whitespace and tag
# serialization, matching element literals in top-level Go.
-- input.gsx --
package demo

import "github.com/gsxhq/gsx"

func wrapN(n gsx.Node) gsx.Node { return n }

var top = <b>  a   b  </b>

component Page(n int) {
	{{ el := <b>  a   b  </b> }}
	{{ w := wrapN(
		<b>
			{ n }
			<i/>
		</b>,
	) }}
	{ top }{ el }{ w }
}
-- invoke --
Page(1)
