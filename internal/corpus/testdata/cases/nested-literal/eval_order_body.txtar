# A hoisted error-carrying hole keeps Go's left-to-right order of calls and
# receives: every call or receive lexically before the hoisting literal (and
# evaluated unconditionally) is pinned to a temp, in source order, before the
# hole's hoist. Each line records the order its calls ran in (the trailing
# { r }). Covered: a call and a method call before the literal, an earlier
# literal's pure hole, a call whose receiver is a call, a receive, a call
# nested in a pinned call (pinned as part of it), a tuple-valued call feeding a
# pinned call, a logical operation with calls (pinned whole, keeping its
# short-circuit), calls inside a func literal (not evaluated there, so not
# pinned), a call producing the called function, a composite literal's
# element, and a type switch guard. Conversions and constants are not calls: they stay in place.
-- input.gsx --
package demo

import (
	"fmt"
	"strings"
)

type rec struct {
	log []string
	ch  chan string
}

func (r *rec) F(s string) string { r.log = append(r.log, s); return s }
func (r *rec) E(s string) (string, error) {
	r.log = append(r.log, fmt.Sprintf("%s(ch=%d)", s, len(r.ch)))
	return s, nil
}
func (r *rec) B(s string) bool         { r.log = append(r.log, s); return true }
func (r *rec) Obj(s string) *rec        { r.log = append(r.log, s); return r }
func (r *rec) Join(a string) string     { return "j:" + a }
func (r *rec) Two(s string) (string, string) { r.log = append(r.log, s); return s, s }
func (r *rec) String() string           { return strings.Join(r.log, ",") }

func newRec() *rec {
	r := &rec{ch: make(chan string, 1)}
	r.ch <- "c"
	return r
}

func join(a, b string) string      { return a + "|" + b }
func join3(a, b, c string) string  { return a + "|" + b + "|" + c }
func pair(a, b string) string      { return a + "+" + b }
func yes(b bool, s string) string  { return fmt.Sprint(b, s) }
func call(f func() string, s string) string { return s }
func (r *rec) Mk(s string) func(string) string { r.log = append(r.log, s); return r.Join }

type pairT struct{ A, B string }

func show(p pairT) string  { return p.A + p.B }
func anyOf(a, b string) any { return a + b }

component Page() {
	{{ r := newRec() }}
	<p>{ join(f`a-@{r.F("1")}`, f`b-@{r.E("2")}`) } { r }</p>
	{{ r = newRec() }}
	<p>{ join(r.F("g"), f`b-@{r.E("2")}`) } { r }</p>
	{{ r = newRec() }}
	<p>{ r.Obj("o").Join(f`b-@{r.E("2")}`) } { r }</p>
	{{ r = newRec() }}
	<p>{ join(<-r.ch, f`b-@{r.E("2")}`) } { r }</p>
	{{ r = newRec() }}
	<p>{ join3(join(r.F("outer"), r.F("inner")), string(r.F("conv")), f`b-@{r.E("2")}`) } { r }</p>
	{{ r = newRec() }}
	<p>{ join(pair(r.Two("two")), f`b-@{r.E("2")}`) } { r }</p>
	{{ r = newRec() }}
	<p>{ yes(r.B("l") && r.B("r"), f`b-@{r.E("2")}`) } { r }</p>
	{{ r = newRec() }}
	<p>{ call(func() string { return r.F("never") }, f`b-@{r.E("2")}`) } { r }</p>
	{{ r = newRec() }}
	<p>{ r.Mk("mk")(f`b-@{r.E("2")}`) } { r }</p>
	{{ r = newRec() }}
	<p>{ show(pairT{A: r.F("a"), B: f`b-@{r.E("2")}`}) } { r }</p>
	{{ r = newRec() }}
	{ switch v := anyOf(r.F("g"), f`b-@{r.E("2")}`).(type) {
	case string:
		<b>{ v }</b>
	} }{ r }
}
-- invoke --
Page()
