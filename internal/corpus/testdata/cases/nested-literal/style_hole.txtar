# A literal nested in a <style> @{ } hole lowers to its Go value, and that
# value takes the hole's CSS value filtering: a plain string goes through the
# filter (an unsafe value becomes ZgotmplZ), a css` literal stays trusted
# RawCSS.
-- input.gsx --
package demo

import "github.com/gsxhq/gsx"

func wrap(s string) string          { return s }
func wrapC(c gsx.RawCSS) gsx.RawCSS { return c }

component Page(w string) {
	<style>p { width: @{ wrap(f`@{w}px`) }; }</style>
	<style>p { color: @{ wrap(f`red;} body {x:@{w}`) }; }</style>
	<style>p { margin: @{ wrapC(css`@{w}px`) }; }</style>
}
-- invoke --
Page("4")
