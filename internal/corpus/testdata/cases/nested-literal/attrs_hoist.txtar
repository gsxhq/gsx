# Error-carrying holes in literals nested in every attribute-side position
# hoist into the right statement buffer with the enclosing function's return
# shape: a native cond-attr branch (inside the `if`), a component input, a
# component cond-attr branch and a leaf spread under a fold (inside the
# AttrsCond thunk, `return nil, _gsxerr`), an attrs-literal pair, a spread
# and a marker name. Elements nested in a pair value and a spread lower to
# gsx.Node values.
-- input.gsx --
package demo

import (
	"errors"

	"github.com/gsxhq/gsx"
)

func wrap(s string) string { return s }
func bag(v string) gsx.Attrs { return gsx.Attrs{{Key: "data-v", Value: v}} }
func nodeBag(n gsx.Node) gsx.Attrs { return gsx.Attrs{{Key: "data-n", Value: n != nil}} }
func lookup(id int) (string, error) {
	if id < 0 {
		return "", errors.New("bad id")
	}
	return "L", nil
}

component Slot(t string, attrs gsx.Attrs) {
	<div { attrs... }>{ t }</div>
}

component Page(id int, on bool) {
	<i { if on { title={wrap(f`a-@{lookup(id)}`)} } }></i>
	<Slot t={wrap(f`b-@{lookup(id)}`)}/>
	<Slot { if on { data-c={wrap(f`c-@{lookup(id)}`)} } }/>
	<Slot attrs={{ "data-d": wrap(f`d-@{lookup(id)}`), "data-e": wrapN(<b>e</b>) != nil }}/>
	<i { bag(f`f-@{lookup(id)}`)... }></i>
	<i { bag("x")... } { if on { { bag(f`g-@{lookup(id)}`)... } } }></i>
	<i { nodeBag(<b>h</b>)... }></i>
	<?marker name={wrap(f`m-@{lookup(id)}`)}>
}

func wrapN(n gsx.Node) gsx.Node { return n }
-- invoke --
Page(1, true)
-- diagnostics.golden --
-- render.golden --
<i title="a-L"></i><div>b-L</div><div data-c="c-L"></div><div data-d="d-L" data-e></div><i data-v="f-L"></i><i data-v="g-L"></i><i data-n></i><?marker name="m-L">
