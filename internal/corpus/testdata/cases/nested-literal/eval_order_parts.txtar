# The parts of one class/style list and the pairs of one attrs literal are one
# evaluation sequence in source order: a later part's or pair's hoisted
# statement (an error-carrying hole, a (T, error) value, a value-form
# if/switch) first pins the earlier values still pending in the consuming
# call. Covered: element class (plain part, guard, literal part, value-form
# part) and style, a component class, a component conditional-attribute
# branch's class, a multi-spread fold's class and style, and attrs-literal
# pairs (a (T, error) value, a nested literal, an untyped nil kept typed by
# its pair). Each line records the order its calls ran in.
-- input.gsx --
package demo

import (
	"strings"

	"github.com/gsxhq/gsx"
)

type rec struct{ log []string }

func (r *rec) F(s string) string { r.log = append(r.log, s); return s }
func (r *rec) E(s string) (string, error) { r.log = append(r.log, s); return s, nil }
func (r *rec) B(s string) bool { r.log = append(r.log, s); return true }
func (r *rec) String() string { return strings.Join(r.log, ",") }

func yes(b bool, s string) bool { return b && s != "" }

component Box(attrs gsx.Attrs) {
	<b { attrs... }></b>
}

component Page(on bool) {
	{{ e := gsx.Attrs{} }}
	{{ r := &rec{} }}
	<p class={ r.F("a"), f`@{r.E("h")}` }></p>{ r }
	{{ r = &rec{} }}
	<p class={ r.F("a"), "k": r.B("c"), f`@{r.E("h")}` }></p>{ r }
	{{ r = &rec{} }}
	<p class={ f`x-@{r.F("a")}`, "k": yes(r.B("g"), f`@{r.E("h")}`) }></p>{ r }
	{{ r = &rec{} }}
	<p class={ r.F("a"), if on { r.F("b") }, r.F("c"), f`@{r.E("h")}` }></p>{ r }
	{{ r = &rec{} }}
	<p style={ r.F("color:red"), css`width:@{r.E("1")}px` }></p>{ r }
	{{ r = &rec{} }}
	<Box class={ r.F("a"), f`@{r.E("h")}` }/>{ r }
	{{ r = &rec{} }}
	<Box { if on { class={ r.F("a"), f`@{r.E("h")}` } } }/>{ r }
	{{ r = &rec{} }}
	<i { e... } { e... } class={ r.F("a"), f`@{r.E("h")}` }></i>{ r }
	{{ r = &rec{} }}
	<i { e... } { e... } style={ r.F("color:red"), css`width:@{r.E("1")}px` }></i>{ r }
	{{ r = &rec{} }}
	<Box attrs={{ "data-a": r.F("a"), "data-b": r.E("b") }}/>{ r }
	{{ r = &rec{} }}
	<Box attrs={{ "data-a": r.F("a"), "data-b": f`@{r.E("b")}` }}/>{ r }
	{{ r = &rec{} }}
	<Box attrs={{ "data-n": nil, "data-a": r.F("a"), "data-b": r.E("b") }}/>{ r }
}
-- invoke --
Page(true)
