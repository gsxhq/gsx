# An error-carrying hole in a literal nested in a conditional-attribute
# condition or an attribute switch tag hoists before its `if`/`switch` (or
# AttrsCond call) on every emission path: a plain element, a pre- and a
# post-spread cond-attr on a one-spread element, a folding element (two
# spreads) and a component tag. After a taken branch, an `else if`'s hole
# (lookup(-1), which would fail) never runs.
-- input.gsx --
package demo

import (
	"errors"

	"github.com/gsxhq/gsx"
)

func ok(s string) bool { return s != "" }
func lookup(id int) (string, error) {
	if id < 0 {
		return "", errors.New("bad id")
	}
	return "L", nil
}

component Box(attrs gsx.Attrs) {
	<b { attrs... }>box</b>
}

component Page(id int, a gsx.Attrs, c gsx.Attrs) {
	<i { if ok(f`@{lookup(id)}`) { title="y" } else if ok(f`@{lookup(-1)}`) { title="z" } }></i>
	<i { switch f`@{lookup(id)}` { case "L": data-s="y" } }></i>
	<i { if ok(f`@{lookup(id)}`) { title="pre" } else if ok(f`@{lookup(-1)}`) { title="z" } } { a... } { if ok(f`@{lookup(id)}`) { id="post" } else if ok(f`@{lookup(-1)}`) { id="z" } }></i>
	<i { a... } { c... } { if ok(f`@{lookup(id)}`) { title="fold" } else if ok(f`@{lookup(-1)}`) { title="z" } }></i>
	<Box { if ok(f`@{lookup(id)}`) { title="comp" } else if ok(f`@{lookup(-1)}`) { title="z" } }/>
	<Box { switch f`@{lookup(id)}` { case "L": data-s="comp" } }/>
}
-- invoke --
Page(1, nil, nil)
-- diagnostics.golden --
-- render.golden --
<i title="y"></i><i data-s="y"></i><i title="pre" id="post"></i><i title="fold"></i><b title="comp">box</b><b data-s="comp">box</b>
