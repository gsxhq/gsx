# A tagless switch with an init statement (`switch x := …; { … }`) carrying a
# nested literal: pure holes keep the authored `switch init; {` header, and an
# error hole in the init hoists inside `{ <hoist>; <init>; switch { … } }` —
# markup, in-tag attribute, component-tag and value-form switches.
-- input.gsx --
package demo

import (
	"errors"

	"github.com/gsxhq/gsx"
)

func wrap(s string) string { return s }
func lookup(id int) (string, error) {
	if id < 0 {
		return "", errors.New("bad id")
	}
	return "L", nil
}

component Box(attrs gsx.Attrs) {
	<b { attrs... }>box</b>
}

component Page(id int) {
	{ switch n := wrap(f`q@{id}`); {
	case n == "q1":
		<b>pure</b>
	} }
	{ switch n := wrap(f`@{lookup(id)}`); {
	case n == "L":
		<b>hoist</b>
	} }
	<i { switch n := wrap(f`q@{id}`); { case n == "q1": title="pure" } }></i>
	<i { switch n := wrap(f`@{lookup(id)}`); { case n == "L": title="hoist" } }></i>
	<Box { switch n := wrap(f`q@{id}`); { case n == "q1": title="pure" } }/>
	<Box { switch n := wrap(f`@{lookup(id)}`); { case n == "L": title="hoist" } }/>
	<i class={ "x", switch n := wrap(f`q@{id}`); { case n == "q1": "pure" } }></i>
	<i class={ "x", switch n := wrap(f`@{lookup(id)}`); { case n == "L": "hoist" } }></i>
}
-- invoke --
Page(1)
-- diagnostics.golden --
-- render.golden --
<b>pure</b><b>hoist</b><i title="pure"></i><i title="hoist"></i><b title="pure">box</b><b title="hoist">box</b><i class="x pure"></i><i class="x hoist"></i>
