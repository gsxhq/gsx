# A body-scope `var ctx` in a {{ }} block that also holds an element literal
# is reserved like any other declaration of ctx. The element before the
# declaration pins that the diagnostic position survives the masked parse.
# (A `ctx, q :=` derivation in the same position is legal — see
# context/derive_goblock_literals.)
-- input.gsx --
package views

import "context"

type key struct{}

component Page(id int) {
	{{ n := <b>{ id }</b>; var ctx = context.WithValue(ctx, key{}, "shadow") }}
	<p>{ n }</p>
}
-- diagnostics.golden --
8:19: 	other declaration of ctx
8:29: identifier "ctx" is reserved (the ambient context) — rename it
8:29: ctx redeclared in this block
