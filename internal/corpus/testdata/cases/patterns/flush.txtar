# COVERAGE: the userland "flush" pattern — a custom node that reaches the raw
# io.Writer for a side effect instead of emitting markup. <Flush/> is a plain,
# no-argument Go func returning gsx.Node (invokable as a bare void-like tag, same
# as <Divider/>); its gsx.Func receives the writer the page renders into and, when
# that writer is an http.ResponseWriter, pushes the bytes written so far to the
# client — so the browser can paint the above-the-fold markup before the slow tail
# finishes. It uses http.NewResponseController(w).Flush(), which walks the writer's
# Unwrap() chain and prefers a FlushError() error (what a buffering middleware
# exposes) over the legacy http.Flusher, surfacing real flush errors into the
# render. A writer that simply can't flush returns ErrNotSupported and is a no-op.
# gsx's Writer is unbuffered (Writer.Node renders children against the underlying
# io.Writer), so the flush boundary is exactly the bytes emitted up to the tag.
# The corpus renders into os.Stdout, which is not an http.ResponseWriter, so Flush
# is a no-op here and writes nothing — the golden shows the surrounding markup
# unchanged.
-- flush.go --
package views

import (
	"context"
	"errors"
	"io"
	"net/http"

	"github.com/gsxhq/gsx"
)

// Flush streams whatever has been written so far to the client. It is a custom
// node: a no-argument Go func returning gsx.Node, invokable as <Flush/>. The
// returned gsx.Func gets the raw io.Writer the page is rendering into and, when
// that writer is an http.ResponseWriter, flushes it via a ResponseController —
// which walks the Unwrap() chain and prefers a FlushError() error over the legacy
// http.Flusher. A writer that can't flush (ErrNotSupported) is a best-effort
// no-op; genuine flush errors propagate. It writes no HTML of its own.
func Flush() gsx.Node {
	return gsx.Func(func(ctx context.Context, w io.Writer) error {
		rw, ok := w.(http.ResponseWriter)
		if !ok {
			return nil
		}
		if err := http.NewResponseController(rw).Flush(); err != nil && !errors.Is(err, http.ErrNotSupported) {
			return err
		}
		return nil
	})
}
-- input.gsx --
package views

component Page() {
	<p>above the fold</p>
	<Flush/>
	<p>the slow tail</p>
}
-- invoke --
Page()
-- render.golden --
<p>above the fold</p><p>the slow tail</p>
