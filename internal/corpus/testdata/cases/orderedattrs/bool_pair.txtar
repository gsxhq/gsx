# Bool values in a {{ }} bag take the same rule at the leaf that an element
# attribute takes at generate time: presence (true → bare, false → omitted)
# unless HTML's own values for the key ARE "true"/"false". disabled/checked are
# HTML booleans, data-show/data-hide are userland, x-show is a library name —
# all presence. aria-expanded keeps the literal "false", because absence would
# mean "not expandable" instead of "collapsed". gsx.Toggle forces presence on
# any name.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component Card(toggleAttrs gsx.Attrs) {
	<div { toggleAttrs... }></div>
}

component Page() {
	<Card toggleAttrs={{ "disabled": true, "checked": false, "data-show": true, "data-hide": false, "aria-expanded": false, "x-show": true, "active": gsx.Toggle(true) }}/>
}
-- invoke --
Page()
