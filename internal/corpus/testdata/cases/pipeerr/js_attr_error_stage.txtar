# Same event-handler attribute (onclick) shape as pipelines/attr_js_value.txtar,
# with a REAL error-returning filter swapped in. The pipeline lowers through the
# emitPipeWrap-backed ExprAttr path like any attribute, so the error stage
# hoists cleanly (as attr_mid_stage.txtar); the result then leaves through the
# event-handler sink, JSValAttr, as a JS string literal.
-- gsx.toml --
filter_packages = ["./filters"]
-- filters/filters.go --
package filters

import "errors"

// Shout upcases-ish by appending "!"; fails on empty input.
func Shout(s string) (string, error) {
	if s == "" {
		return "", errors.New("shout: empty input")
	}
	return s + "!", nil
}
-- input.gsx --
package views

component C(x string) { <div onclick={ x |> shout }>y</div> }
-- invoke --
C("ada")
-- diagnostics.golden --
