package views

import "github.com/gsxhq/gsx"

type P struct{ Name string }

type Holder struct{ Inner P }

component (p P) Meth(n int) {
	<b>{ n }</b>
}

component (p *P) PMeth(n int) {
	<i>{ p.Name }{ n }</i>
}

component (p P) Box(children gsx.Node, attrs gsx.Attrs) {
	<div { attrs... }>{ children }</div>
}

func helper() gsx.Node {
	h := P{}
	return <h.Meth n={9}/>
}

component Card(p P) {
	{{ m := P{} }}<m.Meth n={1}/>
	{ for _, m := range []P{{}} { <m.Meth n={2}/> } }
	<p.Meth n={3}/>
	{{ q := p }}<q.Meth n={4}/>
	{ if r := (P{}); true { <r.Meth n={5}/> } }
	{{ pm := &P{Name: "x"} }}<pm.PMeth n={6}/>
	{{ bx := P{} }}<bx.Box data-k="v">kid</bx.Box>
	{{ hd := Holder{} }}<hd.Inner.Meth n={7}/>
	{{ lm := P{} }}{ gsx.Node(<lm.Meth n={8}/>) }
	{ helper() }
}
-- invoke --
Card(P{})
