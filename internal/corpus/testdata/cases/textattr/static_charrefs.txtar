# A quoted static attribute value is read as HTML reads it: character
# references (&amp;, &quot;, &#34;, &lt;) are decoded, then the value is escaped
# once for output, so pasted HTML renders as authored instead of double-escaped.
# The attribute-value rule applies: a legacy reference without ';' followed by
# an alphanumeric or '=' (&copy=2, &copyright) stays as written. The decoded
# text is what every consumer sees: a URL attribute, class/style, a component's
# string prop, its attrs fallthrough, a folded element and a <script type>.
# Processing-instruction data is never decoded.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component Card(title string, attrs gsx.Attrs) {
	<section { attrs... }>{title}</section>
}

component Page(a gsx.Attrs, b gsx.Attrs) {
	<a href="/s?a=1&amp;b=2" title="Tom &amp; Jerry say &quot;hi&quot;">x</a>
	<a href="/s?a=1&b=2&copy=3" title="&copyright &copy; &#169; &lt;b&gt; &bogus;">y</a>
	<div class="a&amp;b c" style="content:&quot;x&quot;">z</div>
	<Card title="Tom &amp; Jerry" data-x="&lt;i&gt;"/>
	<p { a... } title="A &amp; B" { b... }>fold</p>
	<script type="text/javascript&#x3b; charset=utf-8">let x = 1;</script>
	<?marker name="a&amp;b">
}
-- invoke --
Page(nil, nil)
-- diagnostics.golden --
-- render.golden --
<a href="/s?a=1&amp;b=2" title="Tom &amp; Jerry say &#34;hi&#34;">x</a><a href="/s?a=1&amp;b=2&amp;copy=3" title="&amp;copyright © © &lt;b&gt; &amp;bogus;">y</a><div class="a&amp;b c" style="content:&#34;x&#34;">z</div><section data-x="&lt;i&gt;">Tom &amp; Jerry</section><p title="A &amp; B">fold</p><script type="text/javascript; charset=utf-8">let x = 1;</script><?marker name="a&amp;b">
