# A braced-attribute whole-literal pipeline (`name={f`…` |> f}`) applies on
# every path that routes the attribute into an Attrs bag, as on a native
# element: a component tag's unmatched attribute (hole-free and hole-bearing),
# a component conditional-attribute branch, a multi-spread fold element and
# its conditional-attribute branch, and a fallible final stage. The piped
# value enters the bag like a piped expression attribute, so a URL key is
# sanitized after the pipe (SECURITY: `upper` turns the hole into a
# javascript: URL, still blocked).
-- gsx.toml --
filter_packages = ["./filters"]
-- filters/filters.go --
package filters

import "errors"

func Check(s string) (string, error) {
	if s == "" {
		return "", errors.New("check: empty input")
	}
	return s + "!", nil
}
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component Box(attrs gsx.Attrs) {
	<b { attrs... }></b>
}

component Page(on bool, v, u string, a, c gsx.Attrs) {
	<Box title={f`hi` |> upper}/>
	<Box title={f`hi-@{v}` |> upper}/>
	<Box title={f`hi-@{v}` |> check}/>
	<Box { if on { title={f`hi-@{v}` |> upper} } }/>
	<i { a... } { c... } title={f`hi` |> upper}></i>
	<i { a... } { c... } title={f`hi-@{v}` |> check}></i>
	<i { a... } { c... } { if on { title={f`hi-@{v}` |> upper} } }></i>
	<a { a... } { c... } href={f`@{u}` |> upper}></a>
	<Box href={f`@{u}` |> upper}/>
}
-- invoke --
Page(true, "v", "javascript:alert(1)", gsx.Attrs{}, gsx.Attrs{})
-- diagnostics.golden --
-- render.golden --
<b title="HI"></b><b title="HI-V"></b><b title="hi-v!"></b><b title="HI-V"></b><i title="HI"></i><i title="hi-v!"></i><i title="HI-V"></i><a href="about:invalid#gsx"></a><b href="about:invalid#gsx"></b>
