# The four forms of the same Alpine attribute, side by side, because only the
# first is governed by the bool rule:
#
#   x-show={ open }                   Go bool  → PRESENCE (bare / omitted)
#   x-show="true"                     static   → verbatim, never inspected
#   x-show={ strconv.FormatBool(o) }  string   → the string the author asked for
#   x-show=js`open`                   literal  → a JS expression
#
# gsx does not carve out the Alpine/htmx vocabularies — a name HTML gives no
# true/false vocabulary takes the bool rule whatever library claims it. The
# author who means the string writes one of the middle two forms; a Go bool
# could only have meant presence.
-- input.gsx --
package views

import "strconv"

component Page(open bool) {
	<div x-show={ open }>x</div>
	<div x-show="true">s</div>
	<div x-show={ strconv.FormatBool(open) }>f</div>
	<div x-show=js`open`>j</div>
}
-- invoke --
Page(true)
-- diagnostics.golden --
