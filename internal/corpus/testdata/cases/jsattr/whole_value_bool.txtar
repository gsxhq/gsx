# A Go bool bound to a JS-context attribute renders as PRESENCE, like a bool on
# any other name HTML does not give a true/false vocabulary. gsx does not carve
# out the Alpine/htmx vocabularies: their attributes are written as static
# strings or js`` literals in practice (x-show=js`open`), so a Go bool on one
# can only have meant presence. For an expression, write the literal; for the
# string, write x-show={ strconv.FormatBool(open) }.
-- input.gsx --
package views

component Page(open bool) {
	<div x-show={ open }>x</div>
}
-- invoke --
Page(true)
-- diagnostics.golden --
-- generated.x.go.golden --
