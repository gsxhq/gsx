# A class f`…` literal part (and a literal value-form arm) on a component tag
# that forwards class through its attrs bag lowers exactly like the element
# path: each hole is escaped and the joined string is one class contribution.
# Covers the unconditional part, the guarded part, a literal arm, and the same
# shapes inside a conditional-attribute branch thunk (AttrsCond), where an
# error-carrying hole returns the thunk's (nil, err). Page(-1, true) fails in
# the thunk and the render stops there.
-- input.gsx --
package demo

import (
	"errors"

	"github.com/gsxhq/gsx"
)

func lookup(id int) (string, error) {
	if id < 0 {
		return "", errors.New("bad id")
	}
	return "L", nil
}

component Box(attrs gsx.Attrs) {
	<b { attrs... }></b>
}

component Page(id int, c bool) {
	<Box class={ "a", f`h-@{id}` }/>
	<Box class={ "a", f`g-@{id}`: c }/>
	<Box class={ "a", if c { f`v-@{id}` } else { "z" } }/>
	<Box { if c { class={ "a", f`t-@{id}` } } }/>
	<Box { if c { class={ "a", f`u-@{id}`: id > 1 } } else { class={ f`e-@{id}` } } }/>
	<Box { if c { class={ f`k-@{lookup(id)}` } } }/>
	<Box { if c { class={ if id > 1 { f`w-@{lookup(id)}` } } } }/>
}

component All() {
	<Page id={1} c={true}/>
	<Page id={2} c={false}/>
	<Page id={-1} c={true}/>
}
-- invoke --
All()
-- diagnostics.golden --
-- render.golden --
<b class="a h-1"></b><b class="a g-1"></b><b class="a v-1"></b><b class="a t-1"></b><b class="a"></b><b class="k-L"></b><b></b><b class="a h-2"></b><b class="a"></b><b class="a z"></b><b></b><b class="e-2"></b><b></b><b></b><b class="a h--1"></b><b class="a g--1"></b><b class="a v--1"></b><b class="a t--1"></b><b class="a"></b>
[render error] bad id
