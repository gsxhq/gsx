# bare-comment-touches-text: a line-start // whose immediate post-wsnorm
# sibling is text content is rejected, whichever side the text is on (or
# both), regardless of whether the comment itself carries any text.
-- input.gsx --
package views

component BothSides() {
	<p>
		before
		// note
		after
	</p>
}

component TextBeforeOnly() {
	<p>
		before
		// note
	</p>
}

component TextAfterOnly() {
	<p>
		// note
		after
	</p>
}

component EmptyNextToText() {
	<p>
		before
		//
	</p>
}
