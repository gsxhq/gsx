# Bare line-start // between child tags is a source-only comment: retained in
# the AST (fmt preserves it) and absent from rendered HTML. Surrounding literal
# whitespace remains, including the indentation and newline around each comment.
-- input.gsx --
package views

component C() {
	<div>
		<span>a</span>
		// note between tags
		//
		<span>b</span>
	</div>
}
-- invoke --
C()
-- diagnostics.golden --
-- render.golden --
<div>
		<span>a</span>
		
		
		<span>b</span>
	</div>
