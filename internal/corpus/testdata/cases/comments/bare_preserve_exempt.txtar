# Inside pre/textarea subtrees a line-start // is verbatim display content,
# including nested elements. A markup-attribute boundary starts a fresh comment
# context: legal bare comments there emit nothing.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component C() {
	<pre><code>
// rendered verbatim
x := 1
</code></pre>
	<textarea>
// also verbatim
</textarea>
}

component Slot(header gsx.Node) {
	<div>{header}</div>
}

component SlotInsidePre() {
	<pre><Slot header={
		<span>a</span>
		// slot-in-pre note
		<span>b</span>
	}/></pre>
}
-- invoke --
gsx.Fragment(
	C(),
	SlotInsidePre(),
)
-- diagnostics.golden --
-- render.golden --
<pre><code>
// rendered verbatim
x := 1
</code></pre>
	<textarea>
// also verbatim
</textarea><pre><div><span>a</span>
		
		<span>b</span></div></pre>
