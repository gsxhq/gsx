# A truly empty non-self-closing component-value tag <Chip></Chip> carries no
# children, so it lowers to the same Chip(nil...) call as <Chip/>. Whitespace
# inside invocation tags is literal content, not an empty body; a component
# without a children parameter rejects it just like any other child.
# See reject_children.txtar for that distinction.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

type chipProps struct {
	Attrs gsx.Attrs
}

component renderChip(p chipProps) {
	<span { p.Attrs... }>chip</span>
}

func Chip(attrs ...gsx.Attr) gsx.Node {
	return renderChip(chipProps{Attrs: gsx.Attrs(attrs)})
}

component Page() {
	<div>
		<Chip/>
		<Chip></Chip>
	</div>
}
-- invoke --
Page()
-- diagnostics.golden --
-- render.golden --
<div>
		<span>chip</span>
		<span>chip</span>
	</div>
