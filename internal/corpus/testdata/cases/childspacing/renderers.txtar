Configured text renderers participate in ordinary generation; prose spacing
is normalized syntactically without requiring a spacing diagnostic.
-- gsx.toml --
[renderers]
"./ty.Label" = "corpustest/cases/childspacing_renderers.Label"
"./ty.Badge" = "corpustest/cases/childspacing_renderers.Badge"
-- ty/ty.go --
package ty

type Label struct{ S string }

type Badge struct{ S string }
-- input.gsx --
package views

import (
	"github.com/gsxhq/gsx"
	"corpustest/cases/childspacing_renderers/ty"
)

func Label(v ty.Label) string { return v.S }

func Badge(v ty.Badge) gsx.Node {
	return <span class="badge">{ v.S }</span>
}

func sample(s string) (ty.Label, ty.Badge) { return ty.Label{S: s}, ty.Badge{S: s} }

component C(l ty.Label, b ty.Badge) {
	<p id="string-renderer">
		Owner
		{ l }
	</p>
	<p id="node-renderer">
		Owner
		{ b }
	</p>
}
-- invoke --
C(sample("ann"))
-- diagnostics.golden --
-- render.golden --
<p id="string-renderer">Owner ann</p><p id="node-renderer">Owner <span class="badge">ann</span></p>
