# A float32 renders in its own shortest form (0.1), not widened to float64
# (0.10000000149011612), in every context that formats a number: body text,
# plain/URL/CSS attributes, f/css literal holes, <style>, a named float32, a
# generic whose type set is float32 or mixes widths, gsx.Val and a spread bag.
# <script> JSON-encodes and was already right; float64 output is unchanged.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

type Ratio float32

component Gen32[T ~float32](v T) {
	<i data-v={v}>{v}</i>
}

component GenMixed[T ~float32 | ~float64](v T) {
	<b data-v={v} title=f`@{v}`>{v}</b>
}

component Page(f float32, r Ratio, d float64) {
	<p data-x={f} title=f`v=@{f}` href=f`/p?x=@{f}` style=css`opacity:@{f}`>{f} {r} {d} {f`v=@{f}`}</p>
	<style>.a{opacity:@{f}}</style>
	<script>let x = @{f};</script>
	<Gen32 v={f}/>
	<Gen32 v={r}/>
	<GenMixed v={f}/>
	<GenMixed v={d}/>
	{gsx.Val(f)}
	<div { gsx.Attrs{{"data-y", f}}... }></div>
}
-- invoke --
Page(0.1, 0.1, 0.1)
-- diagnostics.golden --
-- render.golden --
<p data-x="0.1" title="v=0.1" href="/p?x=0.1" style="opacity:0.1">0.1 0.1 0.1 v=0.1</p><style>.a{opacity:0.1}</style><script>let x =  0.1 ;</script><i data-v="0.1">0.1</i><i data-v="0.1">0.1</i><b data-v="0.1" title="0.1">0.1</b><b data-v="0.1" title="0.1">0.1</b>0.1<div data-y="0.1"></div>
