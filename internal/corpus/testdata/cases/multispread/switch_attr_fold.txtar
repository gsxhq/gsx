# A `{ switch … }` attribute group folds into the shared bag of an element with
# two or more spreads exactly like an `{ if … }` group: a source-ordered
# contributor whose taken arm alone is evaluated (an unmatched switch adds
# nothing). Each switch line is followed by its `if` twin and renders the same.
# Covered: a tagged switch between spreads, an init statement, a type switch's
# bound variable, a (T, error) arm value, a switch nested in an if branch and
# an if nested in an arm, an arm's class (merged), and an arm's spread — which,
# as in an if branch, makes a single-spread element fold (also a lone
# switch-nested spread beside a root class).
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

func check(s string) (string, error) { return s + "!", nil }

component Page(n int, v any, a, b gsx.Attrs) {
	<i { a... } { switch n { case 1: data-x="1" default: data-y="d" } } { b... }></i>
	<i { a... } { if n == 1 { data-x="1" } else { data-y="d" } } { b... }></i>
	<i { a... } { b... } { switch n { case 2: data-x="2" } }></i>
	<i { a... } { b... } { if n == 2 { data-x="2" } }></i>
	<i { a... } { b... } { switch m := n * 3; m { case 3: data-m={m} } }></i>
	<i { a... } { b... } { if m := n * 3; m == 3 { data-m={m} } }></i>
	<i { a... } { b... } { switch x := v.(type) { case string: data-s={x} case int: data-n={x} } }></i>
	<i { a... } { b... } { if x, ok := v.(string); ok { data-s={x} } }></i>
	<i { a... } { b... } { switch n { case 1: data-c={check("c")} } }></i>
	<i { a... } { b... } { if n == 1 { data-c={check("c")} } }></i>
	<i { a... } { b... } { if n > 0 { { switch n { case 1: { if true { data-z="z" } } } } } }></i>
	<i { a... } { b... } { if n > 0 { { if n == 1 { { if true { data-z="z" } } } } } }></i>
	<i class="r" { a... } { b... } { switch n { case 1: class="k" } }></i>
	<i class="r" { a... } { b... } { if n == 1 { class="k" } }></i>
	<i { a... } { switch n { case 1: { b... } } }></i>
	<i { a... } { if n == 1 { { b... } } }></i>
	<i class="r" { switch n { case 1: { b... } } }></i>
	<i class="r" { if n == 1 { { b... } } }></i>
	<i class="r" { a... } { switch n { case 1: class="k" } }></i>
	<i class="r" { a... } { if n == 1 { class="k" } }></i>
}
