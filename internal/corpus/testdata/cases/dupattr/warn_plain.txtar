# Two authored attributes naming the same attribute (exactly or in another
# ASCII case) on one element both render, and the browser keeps the first:
# each later one gets a duplicate-attribute WARNING. Output is unchanged.
-- input.gsx --
package views

component C(u string, n string) {
	<i id="a" id="b">1</i>
	<i id="a" ID="b">2</i>
	<a href={u} HREF="/static">3</a>
	<script nonce={n} NONCE="y">init()</script>
	<input hidden HIDDEN/>
}
-- diagnostics.golden --
4:12: warning: attribute "id" is already set on this element; the browser keeps the first one
5:12: warning: attribute "ID" is already set on this element; the browser keeps the first one
6:14: warning: attribute "HREF" is already set on this element; the browser keeps the first one
7:20: warning: attribute "NONCE" is already set on this element; the browser keeps the first one
8:16: warning: attribute "HIDDEN" is already set on this element; the browser keeps the first one
