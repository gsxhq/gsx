# An authored attribute whose name is a case variant of style routes exactly
# like style: Style={expr} composes with the CSS value filter (a hostile value
# renders ZgotmplZ), STYLE=css`…` filters its holes, and it merges with a
# bag's style on a forwarding element.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component Box(v string, attrs gsx.Attrs) {
	<div Style={ v }>1</div>
	<div STYLE=css`color:@{v}`>2</div>
	<div STYLE="margin:0" { attrs... }>3</div>
}
-- invoke --
Box("red;background:url(javascript:alert(1))", gsx.Attrs{{Key: "style", Value: "color:blue"}})
-- diagnostics.golden --
-- render.golden --
<div Style="ZgotmplZ">1</div><div STYLE="color:ZgotmplZ">2</div><div style="margin:0; color:blue">3</div>
