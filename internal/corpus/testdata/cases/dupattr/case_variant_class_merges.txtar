# An authored attribute whose name is a case variant of class routes exactly
# like class: CLASS="x" after a spread composes with the bag's class (one
# attribute), CLASS={…} is a composed class taking f`…` literals.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component Box(x string, attrs gsx.Attrs) {
	<div { attrs... } CLASS="authored">1</div>
	<div CLASS="pre" { attrs... }>2</div>
	<div CLASS={ "a", x }>3</div>
	<div Class={ f`k-@{x}` }>4</div>
}
-- invoke --
Box("q", gsx.Attrs{{Key: "class", Value: "bag"}})
-- diagnostics.golden --
-- render.golden --
<div CLASS="authored bag">1</div><div CLASS="pre bag">2</div><div CLASS="a q">3</div><div Class="k-q">4</div>
