# A `{ switch … }` attribute on a spread-forwarding element has the same
# caller-override semantics as an `{ if … }` attribute, by its position
# relative to the spread: before it, each arm's attribute is a default the
# caller's bag overrides; after it, the taken arm's attribute is forced and the
# bag's copy is dropped. Covered: tagged, tagless and type switches, an init
# statement, a default arm, an unmatched switch, an if nested in an arm and a
# switch nested in an if branch, on both sides of the spread.
-- input.gsx --
package views

import "github.com/gsxhq/gsx"

component Pre(n int, attrs gsx.Attrs) {
	<b { switch n { case 1: data-d="z!" default: data-e="def" } } { attrs... }></b>
}

component Post(n int, attrs gsx.Attrs) {
	<b { attrs... } { switch n { case 1: data-d="z!" default: data-e="def" } }></b>
}

component PostInit(n int, attrs gsx.Attrs) {
	<b { attrs... } { switch m := n * 2; { case m > 1: data-d={m} } }></b>
}

component PostType(v any, attrs gsx.Attrs) {
	<b { attrs... } { switch x := v.(type) { case string: data-d={x} case int: data-n={x} } }></b>
}

component Nested(n int, on bool, attrs gsx.Attrs) {
	<b { if on { { switch n { case 1: data-p="pre" } } } } { attrs... } { switch n { case 1: { if on { data-q="post" } } } }></b>
}

component Page() {
	<Pre n={1} data-d="caller"/>
	<Pre n={2} data-e="caller"/>
	<Pre n={1}/>
	<Post n={1} data-d="caller"/>
	<Post n={2} data-d="caller" data-e="caller"/>
	<Post n={1} data-e="caller"/>
	<PostInit n={1} data-d="caller"/>
	<PostInit n={0} data-d="caller"/>
	<PostType v={"s"} data-d="caller" data-n="caller"/>
	<PostType v={3} data-d="caller" data-n="caller"/>
	<Nested n={1} on={true} data-p="caller" data-q="caller"/>
	<Nested n={2} on={true} data-p="caller" data-q="caller"/>
}
-- invoke --
Page()
