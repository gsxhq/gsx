# A switch arm's attribute is classified for its element, not the switch tag
# expression: src in an <img> switch arm takes the image sink (data:image
# allowed) like the same attribute in an if branch, and an href under a switch
# whose tag is a variable named img stays a navigational sink (data: blocked).
-- input.gsx --
package views

component Img(n int, u string) {
	<img { switch n { case 1: src={u} } }/>
	<img { if n == 1 { src={u} } }/>
	{{ img := n }}
	<a { switch img { case 1: href={u} } }>x</a>
}
-- invoke --
Img(1, "data:image/png;base64,AAAA")
-- diagnostics.golden --
-- render.golden --
<img src="data:image/png;base64,AAAA"><img src="data:image/png;base64,AAAA"><a href="about:invalid#gsx">x</a>
