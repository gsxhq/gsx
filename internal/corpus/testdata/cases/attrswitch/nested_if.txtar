# an `{ if … }` group nested inside a switch arm
-- input.gsx --
package views

component C(n int, c bool) { <div { switch n { case 1: { if c { data-c="y" } else { data-nc="y" } } default: data-other="y" } }>x</div> }
-- invoke --
C(1, false)
-- diagnostics.golden --
-- render.golden --
<div data-nc="y">x</div>
