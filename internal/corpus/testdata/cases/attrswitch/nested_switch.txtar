# a switch attribute nested inside another switch arm
-- input.gsx --
package views

component C(n int, m int) { <div { switch n { case 1: { switch m { case 2: data-m="y" } } default: data-other="y" } }>x</div> }
-- invoke --
C(1, 2)
-- diagnostics.golden --
-- render.golden --
<div data-m="y">x</div>
