# A switch-attribute header's init statement follows Go's scoping on every
# emission path (native element, spread-folding element, component tag): init
# runs once before the tag, and its variables are visible to the tag, the case
# lists, and every arm's values. A type switch's bound variable takes each
# case's type in that case's values.
-- input.gsx --
package views

import (
	"github.com/gsxhq/gsx"
	"strconv"
	"strings"
)

func wrap(s string) string { return strings.ToUpper(s) }

component Box(attrs gsx.Attrs) { <b { attrs... }/> }

component Native(x string) { <i { switch v := wrap(x); v { case "A": data-a={v} case v + "": data-same={v + "!"} } }/> }

component Folding(x string, attrs gsx.Attrs) { <i { attrs... } { switch v := wrap(x); v { case "A": data-a={v} default: data-d={v + "!"} } }/> }

component Tag(x string) { <Box { switch v := wrap(x); { case v == "A": data-a={v} default: data-d={v + "!"} } }/> }

component TypeNative(x any) { <i { switch v := x.(type) { case int: data-int={strconv.Itoa(v + 1)} case string: data-str={v + "!"} } }/> }

component TypeFolding(x any, attrs gsx.Attrs) { <i { attrs... } { switch v := x.(type) { case int: data-int={strconv.Itoa(v + 1)} default: data-other="y" } }/> }

component TypeTag(x any) { <Box { switch v := x.(type) { case int: data-int={strconv.Itoa(v + 1)} case string: data-str={v + "!"} } }/> }

component All() {
	{ Native("a") }
	{ Native("b") }
	{ Folding("a", gsx.Attrs{{Key: "id", Value: "f"}}) }
	{ Folding("b", nil) }
	{ Tag("a") }
	{ Tag("b") }
	{ TypeNative(1) }
	{ TypeNative("s") }
	{ TypeFolding(2, nil) }
	{ TypeFolding(true, nil) }
	{ TypeTag(3) }
	{ TypeTag("t") }
}
-- invoke --
All()
-- diagnostics.golden --
-- render.golden --
<i data-a="A"></i><i data-same="B!"></i><i id="f" data-a="A"></i><i data-d="B!"></i><b data-a="A"></b><b data-d="B!"></b><i data-int="2"></i><i data-str="s!"></i><i data-int="3"></i><i data-other="y"></i><b data-int="4"></b><b data-str="t!"></b>
