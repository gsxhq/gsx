The separator after a cluster is decided once the cluster has printed, at the
column where its last line ends. A word that would run past the margin after a
broken block's last line moves to the next line (AfterBrokenBlock). A cluster
that ends exactly at the margin keeps its block flat; the next word goes to the
next line instead of the block breaking to make room (ExactFit).

-- input.gsx --
package p

component AfterBrokenBlock(ok bool) {
	<p>
		lorem ipsum{ if ok { <b>yes, and the bold words in this block run long enough to overflow</b> } } xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx more.
	</p>
}

component ExactFit(ok bool) {
	<p>
		aaaa bbbb cccc dddd eeee ffff gggg hhhh iiii jjjj { if ok { <b>cc</b> } } dd ee
	</p>
}
-- fmt.golden --
package p

component AfterBrokenBlock(ok bool) {
	<p>
		lorem ipsum{ if ok {
			<b>yes, and the bold words in this block run long enough to overflow</b>
		} } xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
		more.
	</p>
}

component ExactFit(ok bool) {
	<p>
		aaaa bbbb cccc dddd eeee ffff gggg hhhh iiii jjjj { if ok { <b>cc</b> } } dd
		ee
	</p>
}
