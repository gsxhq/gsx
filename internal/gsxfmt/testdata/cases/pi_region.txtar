Nested marker regions keep correctly authored HTML indentation and literal
child text. Formatting their syntax must not introduce content separators.

-- input.gsx --
package ui

component Page(id string) {
<?start name="panel">
	<p>loading</p>
	<?start name={id}>
		<span>nested</span>
	<?end>
<?end>
}
-- fmt.golden --
package ui

component Page(id string) {
<?start name="panel">
	<p>loading</p>
	<?start name={id}>
		<span>nested</span>
	<?end>
<?end>
}
