Marker regions preserve their literal child text and authored open/close
placement, including unconventional indentation. Nested regions do not force
new block layout or introduce separators; only their syntax may format.

-- input.gsx --
package ui

component Page(id string) {
<?start name="panel">
			<p>loading</p>
<?start name={id}>
						<span>nested</span>
	<?end>
			<?end>
}
-- fmt.golden --
package ui

component Page(id string) {
<?start name="panel">
			<p>loading</p>
<?start name={id}>
						<span>nested</span>
	<?end>
			<?end>
}
