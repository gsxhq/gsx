Multiline HTML operands keep their correctly authored nesting indentation.
Literal newlines do not force decorative parentheses or expansion of every
composite field; ordinary Go syntax and width decisions remain canonical.

-- input.gsx --
package ui

var nav = []item{
	{label: "Team View", icon: <UsersIcon>
		<title>users</title>
	</UsersIcon>, page: TeamViewPage{}, pathMatch: "/team"},
	{label: "Search", icon: <SearchIcon>
		<title>search</title>
	</SearchIcon>, page: ListPage{}, pathMatch: "/list/"},
}
-- fmt.golden --
package ui

var nav = []item{
	{
		label:     "Team View",
		icon:      <UsersIcon>
		<title>users</title>
	</UsersIcon>,
		page:      TeamViewPage{},
		pathMatch: "/team",
	},
	{label: "Search", icon: <SearchIcon>
		<title>search</title>
	</SearchIcon>, page: ListPage{}, pathMatch: "/list/"},
}
