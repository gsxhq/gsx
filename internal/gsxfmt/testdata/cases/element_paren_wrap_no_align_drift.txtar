Two composite items contain multiline element operands. Preserve the authored
item prefixes and literal columns instead of introducing decorative parens or
expanding fields independently of their fixed HTML. Formatting again must not
add alignment cells to the fields following either operand (the historical #62
regression). Go syntax outside these constrained regions can still format.

-- input.gsx --
package ui

var nav = []item{
	{label: "Team View", icon: <UsersIcon>
		<title>users</title>
	</UsersIcon>, page: TeamViewPage{}, pathMatch: "/team"},
	{label: "Search", icon: <SearchIcon>
		<title>search</title>
	</SearchIcon>, page: ListPage{}, pathMatch: "/list/"},
}
-- fmt.golden --
package ui

var nav = []item{
	{label: "Team View", icon: <UsersIcon>
		<title>users</title>
	</UsersIcon>, page: TeamViewPage{}, pathMatch: "/team"},
	{label: "Search", icon: <SearchIcon>
		<title>search</title>
	</SearchIcon>, page: ListPage{}, pathMatch: "/list/"},
}
