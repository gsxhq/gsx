Formatting control-flow syntax inside prose is idempotent while preserving
every literal text byte and touching boundary around that syntax.

-- input.gsx --
package p

component Touching(ok bool) {
	<p>
		lorem ipsum dolor sit amet consectetur amet{ if ok { <b>yes, and the bold words in this block run long enough to overflow</b> } }consectetur adipiscing elit sed do eiusmod.
	</p>
}

component Spaced(ok bool) {
	<p>
		lorem ipsum dolor sit amet consectetur amet { if ok { <b>yes, and the bold words in this block run long enough to overflow</b> } } consectetur adipiscing elit sed do eiusmod.
	</p>
}

component Fragment() {
	<p>
		lorem ipsum dolor sit amet consectetur amet<><b>first</b> <i>second</i> <u>third and some more inline words to overflow</u></>consectetur adipiscing elit.
	</p>
}

component Region() {
	<p>
		lorem ipsum dolor sit amet consectetur amet<?start name="s"><b>yes, and the bold words in this block run long enough to overflow</b><?end>consectetur adipiscing elit sed do eiusmod.
	</p>
}

component FirstLineOverflows(ok bool) {
	<p>
		lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor { if ok { <b>yes</b> } } consectetur.
	</p>
}
