Joined inline content stays joined even beyond the print width. Prose boundaries
with source whitespace normalize to one separator and can format canonically.
Authored punctuation adjacency remains attached; breaks beside block content remain layout only.
The shared rule looks through comments and Go blocks across the children list,
including lists containing block and inline segments.

-- input.gsx --
package p

component Slash() {
	<p>
		xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx <code>--font-sans</code>/<code>--font-heading</code> trailing words here.
	</p>
}

component Interp(s string) {
	<p>
		xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx yy/{s}/zzz trailing words here.
	</p>
}

component Brackets() {
	<p>
		xxxxxxxxxxxxxxxxx (<a href="/x" class="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa">link</a>)/<b>bold</b> more words.
	</p>
}

component IfBlock(ok bool) {
	<p>
		xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx yyyyy/{ if ok { <b>yes</b> } }/zzz words here.
	</p>
}

component LineBreaks() {
	<p>
		xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx line one<br/>line two<br/>line three<br/>four
	</p>
}

component AuthorBreaks(n int) {
	<p>
		See
		<b>this</b>
		now
	</p>
	<p>
		Status
		{ if n > 0 {
			<strong>ok</strong>
		} }
	</p>
}

component LookThroughInBlockList() {
	<p>
		<b>x</b>
		<!-- c -->
		tail
	</p>
	<div>
		<div>block</div>
		here
		{/* c */}
		<b>after comment</b>
	</div>
	<p>
		<div>block</div>
		here{{ x := 1; _ = x }}<b>after</b>
	</p>
}

-- fmt.golden --
package p

component Slash() {
	<p>
		xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx <code>--font-sans</code>/<code>--font-heading</code> trailing
		words here.
	</p>
}

component Interp(s string) {
	<p>
		xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx yy/{ s }/zzz
		trailing words here.
	</p>
}

component Brackets() {
	<p>
		xxxxxxxxxxxxxxxxx
		(<a href="/x" class="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa">link</a>)/<b>bold</b> more
		words.
	</p>
}

component IfBlock(ok bool) {
	<p>
		xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx yyyyy/{ if ok {
			<b>yes</b>
		} }/zzz words here.
	</p>
}

component LineBreaks() {
	<p>
		xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx line
		one<br/>line two<br/>line three<br/>four
	</p>
}

component AuthorBreaks(n int) {
	<p>
		See <b>this</b> now
	</p>
	<p>
		Status { if n > 0 {
			<strong>ok</strong>
		} }
	</p>
}

component LookThroughInBlockList() {
	<p>
		<b>x</b> <!-- c -->
		tail
	</p>
	<div>
		<div>block</div> here {/* c */}
		<b>after comment</b>
	</div>
	<p>
		<div>block</div> here{{
			x := 1
			_ = x
		}}<b>after</b>
	</p>
}
