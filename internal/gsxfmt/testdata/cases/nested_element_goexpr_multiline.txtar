Multiline HTML operands appear in component inputs, interpolations, Go blocks,
control-flow headers and f`` literal arguments. The smallest surrounding Go
regions retain source placement while independent syntax formats. Literal
indentation, including the pre element's content, must survive exactly; the
formatter must be idempotent without relocating only an operand's first line.

-- input.gsx --
package p

component Row(n int) {
	<Holder h={wrapN(
				<b>
					{ n }
				</b>,
		)}/>
	<p>{ wrapN(
	<b>
	{ n }
	</b>,
	) }</p>
	{{ w := wrapN(
		<b>
			{ n }
		</b>,
	) }}
	<div>{ wrapN(
			<pre>
  x
     y
</pre>,
	) }</div>
	{ if wrapN(
		<b>x</b>,
	) != nil {
		<p>{ w }</p>
	} }
	<i title={wrap(
		f`x`,
	)}></i>
}
-- fmt.golden --
package p

component Row(n int) {
	<Holder h={wrapN(
				<b>
					{ n }
				</b>,
		)}/>
	<p>{ wrapN(
	<b>
	{ n }
	</b>,
		) }</p>
	{{ w := wrapN(
		<b>
			{ n }
		</b>,
	) }}
	<div>{ wrapN(
			<pre>
  x
     y
</pre>,
		) }</div>
	{ if wrapN(
		<b>x</b>,
	) != nil {
		<p>{ w }</p>
	} }
	<i
		title={
			wrap(
				f`x`,
			)
		}
	></i>
}
