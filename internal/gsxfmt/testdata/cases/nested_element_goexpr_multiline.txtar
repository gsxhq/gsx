A multi-line element literal nested in a Go expression, in each Go-expression
position family: a component input, a body interpolation, a {{ }} block, a
control-flow header, and a multi-line f`` literal argument. gofmt lays out the
Go around each value and the element prints from its AST at the Go line's
depth, so the result is a fixed point (the input's deliberately wrong
indentation is fixed once, never shifted again). A <pre> inside the element
keeps its text byte for byte, since reindenting it would change the render.

-- input.gsx --
package p

component Row(n int) {
	<Holder h={wrapN(
				<b>
					{ n }
				</b>,
		)}/>
	<p>{ wrapN(
	<b>
	{ n }
	</b>,
	) }</p>
	{{ w := wrapN(
		<b>
			{ n }
		</b>,
	) }}
	<div>{ wrapN(
			<pre>
  x
     y
</pre>,
	) }</div>
	{ if wrapN(
		<b>x</b>,
	) != nil {
		<p>{ w }</p>
	} }
	<i title={wrap(
		f`x`,
	)}></i>
}
-- fmt.golden --
package p

component Row(n int) {
	<Holder
		h={
			wrapN(
				<b>
					{ n }
				</b>,
			)
		}
	/>
	<p>
		{ wrapN(
			<b>
				{ n }
			</b>,
		) }
	</p>
	{{
		w := wrapN(
			<b>
				{ n }
			</b>,
		)
	}}
	<div>
		{ wrapN(
			<pre>
  x
     y
</pre>,
		) }
	</div>
	{ if wrapN(
		<b>x</b>,
	) != nil {
		<p>{ w }</p>
	} }
	<i
		title={
			wrap(
				f`x`,
			)
		}
	></i>
}
