Embedded HTML operands in attributes, interpolation, Go blocks and control
headers have deliberately authored nesting indentation. The pre operand alone
contains irregular data whose bytes must survive formatting. Go syntax around
all operands remains independently formattable.

-- input.gsx --
package p

component Row(n int) {
	<Holder h={wrapN(
			<b>
				{ n }
			</b>,
		)}/>
	<p>{ wrapN(
			<b>
				{ n }
			</b>,
	) }</p>
	{{ w := wrapN(
		<b>
			{ n }
		</b>,
	) }}
	<div>{ wrapN(
			<pre>
  x
     y
</pre>,
	) }</div>
	{ if wrapN(
		<b>x</b>,
	) != nil {
		<p>{ w }</p>
	} }
	<i title={wrap(
		f`x`,
	)}></i>
}
-- fmt.golden --
package p

component Row(n int) {
	<Holder
		h={
			wrapN(
				<b>
				{ n }
			</b>,
			)
		}
	/>
	<p>{ wrapN(
			<b>
				{ n }
			</b>,
		) }</p>
	{{
		w := wrapN(
			<b>
			{ n }
		</b>,
		)
	}}
	<div>{ wrapN(
			<pre>
  x
     y
</pre>,
		) }</div>
	{ if wrapN(
		<b>x</b>,
	) != nil {
		<p>{ w }</p>
	} }
	<i
		title={
			wrap(
				f`x`,
			)
		}
	></i>
}
