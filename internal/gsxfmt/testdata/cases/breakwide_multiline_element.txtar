An embedded element with authored literal newlines constrains its surrounding
Go syntax placement. Its composite item retains its readable opening line
without invented parentheses or field expansion. Flat elements remain flat.

-- input.gsx --
package ui

var nav = []item{
	{label: "Team View", icon: <UsersIcon>
		<title>users</title>
	</UsersIcon>, page: TeamViewPage{}},
}
-- fmt.golden --
package ui

var nav = []item{
	{label: "Team View", icon: <UsersIcon>
		<title>users</title>
	</UsersIcon>, page: TeamViewPage{}},
}
