An embedded element with authored literal newlines remains multiline. Its
Go composite literal may wrap fields and add decorative parentheses while
the markup content stays byte-exact. Flat elements remain flat values.

-- input.gsx --
package ui

var nav = []item{
	{label: "Team View", icon: <UsersIcon>
		<title>users</title>
	</UsersIcon>, page: TeamViewPage{}},
}
-- fmt.golden --
package ui

var nav = []item{
	{
		label: "Team View",
		icon:  (
			<UsersIcon>
		<title>users</title>
	</UsersIcon>
		),
		page:  TeamViewPage{},
	},
}
