Prose is literal content. Long lines stay long and authored wrap points remain
exact, including spaces around nested tags and interpolations.

-- input.gsx --
package p

component LongProseStaysLong() {
	<p>Literal HTML prose keeps every authored space and newline: this deliberately long line exceeds the formatter width, and its source remains a long line because moving words would change text content and could change how CSS white-space rules display the paragraph.</p>
}

component AuthorWrapStaysLiteral() {
	<p>
		Hand-wrapped
		prose at an
		arbitrary short
		column count does
		survive formatting: the printer retains every one of these
		author break points and preserves the whole paragraph with its
		authored whitespace, even when another layout might fit a chosen
		column budget more neatly.
	</p>
}

component InlineTagKeepsSurroundingProse() {
	<p>
		This sentence sits before a <code>reallyLongIdentifierNameThatByItselfAlreadyExceedsTheEightyColumnPrintWidthBudgetEntirely</code> and continues after it with more prose whose authored spaces and line boundaries stay literal.
	</p>
}
