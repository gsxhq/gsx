Tag attribute layout respects configured tab width; child content stays exact.
Indentation is emitted as tabs for either width.

-- tab_width --
4
-- input.gsx --
package ui
component C() { <div class="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa">x</div> }
-- fmt.golden --
package ui

component C() {
	<div
		class="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
	>x</div>
}
