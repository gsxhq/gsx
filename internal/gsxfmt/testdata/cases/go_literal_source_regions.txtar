func render(n int) any {
	switch n { case 1: return Wrap(<b>
		one
	</b>); default: return nil }
}

component C() {
	<Box node={ Wrap(<b>
		attr
	</b>) }/>
	<p>{ Wrap(<b>
		interp
	</b>) }</p>
	{{node:=Wrap(<b>
		block
	</b>);outside:=1+2;_=outside}}
	{ if Wrap(<b>
		header
	</b>)!=nil { <i/> } }
	{ switch Wrap(<b>
		switch
	</b>) { case nil: <i/> } }
}
-- fmt.golden --
package p

var before = 1 + 2
var rows = []item{
	{label: "a", icon: <Icon>
		<title>x</title>
	</Icon>, page: P{}},
}
var pair = Pair(<b>
	x
</b>, <i>
	y
</i>)
var after = 3 + 4

func render(n int) any {
	switch n {
	case 1:
		return Wrap(<b>
		one
	</b>)
	default:
		return nil
	}
}

component C() {
	<Box
		node={
			Wrap(<b>
		attr
	</b>)
		}
	/>
	<p>{ Wrap(<b>
		interp
	</b>) }</p>
	{{
		node := Wrap(<b>
		block
	</b>)
		outside := 1 + 2
		_ = outside
	}}
	{ if Wrap(<b>
		header
	</b>) != nil {
		<i/>
	} }
	{ switch Wrap(<b>
		switch
	</b>) {
	case nil: <i/>
	} }
}
