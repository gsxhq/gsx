A line break in the opening tag keeps the attribute list block-formatted.
Changing tag syntax never inserts whitespace into the literal children.

-- input.gsx --
package p

component C() {
	<a
		href="/help"
		class="text-blue-600"
	>?</a>
}
-- fmt.golden --
package p

component C() {
	<a
		href="/help"
		class="text-blue-600"
	>?</a>
}
