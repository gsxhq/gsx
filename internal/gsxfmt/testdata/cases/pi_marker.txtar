Void processing instructions preserve their authored placement among literal
children. Their syntax and expression attributes may format, but no block-tag
assumption inserts newlines or reindents the surrounding HTML whitespace.
Both static and pipelined expression attribute values are covered.

-- input.gsx --
package ui

component Page(id string) {
<div>
<?marker name="results">
					<?marker name={id |> upper}>
</div>
}
-- fmt.golden --
package ui

component Page(id string) {
<div>
<?marker name="results">
					<?marker name={id |> upper}>
</div>
}
