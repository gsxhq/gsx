Source comments emit nothing. Authored indentation surrounding comments is
literal HTML data, including the deliberately over-indented Weird regression.
The formatter must retain that data while formatting independent syntax.

-- input.gsx --
package ui

component Between() {
	<div>
		<span>a</span>
		// between two tags
		<span>b</span>
	</div>
}

component Weird() {
	<div>
		<span>a</span>
				// over-indented in source
		<span>b</span>
	</div>
}

component Fits() {
	<p>{a}
// forces multi-line
{b}</p>
}

component Empty() {
	<div>
		<span>a</span>
		//
		<span>b</span>
	</div>
}

component Braced() {
	<div>
		<span>a</span>
		{// stays braced
		}
		<span>b</span>
	</div>
}
-- fmt.golden --
package ui

component Between() {
	<div>
		<span>a</span>
		// between two tags
		<span>b</span>
	</div>
}

component Weird() {
	<div>
		<span>a</span>
				// over-indented in source
		<span>b</span>
	</div>
}

component Fits() {
	<p>{ a }
// forces multi-line
{ b }</p>
}

component Empty() {
	<div>
		<span>a</span>
		//
		<span>b</span>
	</div>
}

component Braced() {
	<div>
		<span>a</span>
		{// stays braced
		}
		<span>b</span>
	</div>
}
