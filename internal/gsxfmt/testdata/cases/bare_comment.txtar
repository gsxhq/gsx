A bare line-start // content comment always occupies its own line at the child
indent: it is reindented from any source column, it forces an otherwise-inline
element multi-line (with the following sibling on a fresh line), an empty
comment stays a bare // with no trailing space, and the braced {// x } form is
never converted to or from the bare form.
-- input.gsx --
package ui

component Between() {
	<div>
		<span>a</span>
		// between two tags
		<span>b</span>
	</div>
}

component Weird() {
	<div>
		<span>a</span>
				// over-indented in source
		<span>b</span>
	</div>
}

component Fits() {
	<p>{a}
// forces multi-line
{b}</p>
}

component Empty() {
	<div>
		<span>a</span>
		//
		<span>b</span>
	</div>
}

component Braced() {
	<div>
		<span>a</span>
		{// stays braced
		}
		<span>b</span>
	</div>
}
-- fmt.golden --
package ui

component Between() {
	<div>
		<span>a</span>
		// between two tags
		<span>b</span>
	</div>
}

component Weird() {
	<div>
		<span>a</span>
		// over-indented in source
		<span>b</span>
	</div>
}

component Fits() {
	<p>
		{ a }
		// forces multi-line
		{ b }
	</p>
}

component Empty() {
	<div>
		<span>a</span>
		//
		<span>b</span>
	</div>
}

component Braced() {
	<div>
		<span>a</span>
		{// stays braced
		}
		<span>b</span>
	</div>
}
