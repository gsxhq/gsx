Literal HTML content keeps every authored tab, LF, space and touching boundary.
Only the Go-like body edges are formatting opportunities; tags and CSS classes
never authorize reflow or reindentation of their child text.

-- input.gsx --
package p
component C(ok bool) { <div class="whitespace-pre-wrap"> a	b
    <span> x </span><strong>y</strong>!
	{ if ok { <b>yes</b> <i>indeed</i> } else { no } }
	<>
  z	 </>
	<?start name="r"> 	x
 <?end>
	// source comment
	<p>last</p>
</div> }
-- fmt.golden --
package p

component C(ok bool) {
	<div
		class="whitespace-pre-wrap"
	> a	b
    <span> x </span><strong>y</strong>!
	{ if ok {
		<b>yes</b> <i>indeed</i>
	} else {
		no
	} }
	<>
  z	 </>
	<?start name="r"> 	x
 <?end>
	// source comment
	<p>last</p>
</div>
}
