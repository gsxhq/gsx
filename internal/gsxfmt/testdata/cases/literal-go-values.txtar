Embedded markup carries literal Text through structural Go holes. Source
placement around multiline operands stays coherent while independent Go
syntax formats; the semantic AST remains the authority for markup content.

-- input.gsx --
package p
var n=<span>a	b
  c</span>
component C() {
{{n:=<div>x
 	y</div>;_=n}}
{ Wrap(<span>a
	b</span>) }
<Card node={ Wrap(<span>a
  b</span>) } slot={ <b>a</b> <i>b</i> }/>
}
-- fmt.golden --
package p

var n=<span>a	b
  c</span>
component C() {
{{n:=<div>x
 	y</div>
	_ = n}}
{ Wrap(<span>a
	b</span>) }
<Card node={ Wrap(<span>a
  b</span>) } slot={ <b>a</b> <i>b</i> }/>
}
