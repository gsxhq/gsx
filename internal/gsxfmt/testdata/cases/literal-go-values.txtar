Multiline HTML text is preserved exactly while surrounding Go syntax formats.
Unusual literal whitespace in this regression input is deliberate data; Go
spacing and declarations are not frozen to retain original opening columns.

-- input.gsx --
package p
var n=<span>a	b
  c</span>
component C() {
{{n:=<div>x
 	y</div>;_=n}}
{ Wrap(<span>a
	b</span>) }
<Card node={ Wrap(<span>a
  b</span>) } slot={ <b>a</b> <i>b</i> }/>
}
-- fmt.golden --
package p

var n = <span>a	b
  c</span>
component C() {
{{
	n := <div>x
 	y</div>
	_ = n
}}
{ Wrap(<span>a
	b</span>) }
<Card
	node={
		Wrap(<span>a
  b</span>)
	}
	slot={ <b>a</b> <i>b</i> }
/>
}
