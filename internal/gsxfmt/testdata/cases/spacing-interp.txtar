package p

component SeeSpacingAtLineEnd() {
	<p>
		caller-class-merge behaves as documented in the theming guide (see{ " " }
		<a href="/docs/theming" class="underline underline-offset-4">Theming</a>)
	</p>
}

component SpacingBetweenAtoms() {
	<p>
		<code>a</code>{ " " }<code>b</code> renders with a real space between two
		atoms even though there is no literal space character in the source.
	</p>
}
