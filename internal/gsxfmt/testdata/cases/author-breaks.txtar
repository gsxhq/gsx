Authored newlines between markup siblings remain literal Text in every
children-list context. Syntactic case-body edge layout remains separately
recorded by BodyMultiline. Prose line breaks are preserved too.

-- input.gsx --
package p

component SiblingsStayPerLine() {
	<div>
		<img src="/a.png" alt="a"/>
		<br/>
		<input type="text"/>
	</div>
}

component SiblingsStayInline() {
	<div><em>a</em><em>b</em></div>
}

component SwitchArmsStayPerLine(kind string) {
	<span>
		{ switch kind {
			case "warn":
				<b>warning</b>
				<br/>
			case "err":
				<b>error</b>
			default:
				<b>info</b>
		} }
	</span>
}

component SwitchArmsStayInline(kind string) {
	<span>
		{ switch kind {
			case "warn":<b>warning</b>
			default:<b>info</b>
		} }
	</span>
}

component IfBodySiblingsStayPerLine(ok bool) {
	<div>
		{ if ok {
			<b>a</b>
			<b>b</b>
		} }
	</div>
}

component TopLevelSiblingsStayPerLine() {
	<br/>
	<hr/>
}
