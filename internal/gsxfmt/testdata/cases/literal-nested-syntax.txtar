Nested syntax uses structural indentation while literal Text keeps its exact
bytes, including unconventional indentation. Short tags stop measuring at the
next literal LF, rather than counting all later lines against their budget.

-- input.gsx --
package p
component C(ok bool) { <div>
		<span
class="x"
> a	b
 	x</span>
		{ if ok {
<Card
name="value"
/>
} }
	</div> }
-- fmt.golden --
package p

component C(ok bool) { <div>
		<span
			class="x"
		> a	b
 	x</span>
		{ if ok {
			<Card
				name="value"
			/>
		} }
	</div> }
